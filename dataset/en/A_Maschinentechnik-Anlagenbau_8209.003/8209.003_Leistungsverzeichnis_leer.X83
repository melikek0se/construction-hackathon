<?xml version='1.0' encoding='UTF-8'?>
<!-- GXML Toolbox V3.3 R20220330;  [URL_012]  --><GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.2"><GAEBInfo><Version>3.2</Version><VersDate>2013-10</VersDate><Date>2024-02-27</Date><Time>13:41:47</Time><ProgSystem>/ GXML Toolbox V3.3 R20220330</ProgSystem><ProgName>ORCA AVA 25.0.4 - Professional Edition 25.00.04</ProgName><Certific>Available</Certific></GAEBInfo><PrjInfo><NamePrj>8209.003</NamePrj><LblPrj>[PROJEKT_002]</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>83</DP><AwardInfo><Cur>EUR</Cur><CurLbl>Euro</CurLbl></AwardInfo><BoQ ID="id2"><BoQInfo><Name>01</Name><LblBoQ>Mechanical engineering - plant construction</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Section</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Area</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn><NoUPComps>4</NoUPComps><LblUPComp1 Type="Wages">Labour</LblUPComp1><LblUPComp2 Type="Materials">Materials</LblUPComp2><LblUPComp3 Type="Plant">Equipment</LblUPComp3><LblUPComp4 Type="Miscellaneous">Other</LblUPComp4><LblTime>Hours</LblTime></BoQInfo><BoQBody><BoQCtgy ID="id185" RNoPart="01"><LblTx><p><span>Site setup - assembly drawings - commissioning</span></p></LblTx><BoQBody><BoQCtgy ID="id186" RNoPart="01"><LblTx><p><span>Site setup and documentation</span></p></LblTx><BoQBody><Itemlist><Item ID="id187" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Complete setup of the site, keep available on site and clear after the end of the construction measure,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">in accordance with all services stated, with all installations, equipment and machines required for site operations and the mechanical assembly, as well as clearing of the same after completion of the construction measure.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The costs for keeping available on site and operating the above-mentioned installations, equipment and machines are to be included in the relevant unit prices.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Securing of the site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Provision of construction and assembly lighting and of all required lifting gear, assembly scaffolds and protective scaffolds</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with a working platform height according to the requirements is to be included in the price. The contractor cannot assume that scaffolds, lifting gear etc. of other trades working on the site are available.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">All transport and crane costs for supply and installation of all components within the scope of this bill of quantities.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Protecting vessels, pipelines, units during the construction period until commissioning, unless included in other items.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Power connection and site toilet are set up by the builder's works trade and made available for use by following trades.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The existence of a water connection for the assembly period cannot be guaranteed at the present time.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Incl. ancillary costs for overnight stay,meals, travel costs, travel allowances.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Incl. intermediate transport of the materials on the site to the individual installation locations.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Billing mode:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">As a percentage according to construction progress (i.e. in the ratio of the total of the further services performed to the total scope of the services).</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Site setup and clearing</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id188" RNoPart="2"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Piping and instrument flow diagram in plant and process engineering (P&amp;I flow diagram) on the basis of the flow diagram, status "detailed design", which is made available by the AG in pdf format and, if required, in dwg format.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The contractor must submit, at the latest 4 weeks after award of the contract, a schematic drawing in single-line representation of the technical equipment of the waterworks within the scope of this description of work.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The schematic contains the following information for all plant components:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kind and designation of the apparatus, machines, drives, and vessels as a symbol,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pipelines, valves with nominal diameters, pressure ratings, materials</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Functions of the devices for measuring, controlling, regulating</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Additional information, such as e.g. elevations of the apparatus, further materials, is to be stated.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The mode of operation of the mechanical, hydraulic and ventilation equipment of the plant must be clearly and comprehensibly recognisable from the schematic.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">All items of equipment (symbols) contained in the schematic drawing must be assigned a clear key (code number), with the help of which every item of equipment can be unambiguously determined and recognised.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The schematic drawing is to be prepared in dwg format. The drawing must be submitted both in [PERSON_097] and as a CAD file (dwg format) and as a pdf file.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Submission in a single copy.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Piping and instrumentation flow diagram</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id189" RNoPart="3"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">For an overview of the entire treatment plant with connected functional units (such as pressure pumping station), a complete flow diagram is to be supplied after completion, which contains all plant components (apparatus, pipelines, valves, measuring devices etc.) stating nominal diameter, pressure rating, [PERSON_094] and further important technical data as well as stating all short designations.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The drawing is to be supplied on the basis of the item "Piping and instrumentation flow diagram" in visually high-quality form with "presentation character", laminated onto a sturdy plastic panel or in a visually high-quality glass picture frame, in each case with two hangers for wall hanging. Advertising is permitted on this drawing only in the form of the logos of client, design office and contractor (executing company).</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Overview flow diagram for wall hanging</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id190" RNoPart="4"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The contractor shall bindingly submit the documents listed below to site management for checking and approval by the contractual individual deadlines and in good time before ordering materials:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Preparing construction and assembly drawings, recess, foundation and installation drawings and complete installation plans, which must also contain the largest dimensions of the machines with accessories.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">According to these drawings the required recesses etc. - unless included in the scope of this bill of quantities - are produced by others on site. Clear representation in views, sections and detail drawings.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Including fabrication drawings for vessels and special components for the entire scope of services, here in particular:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">filter vessels, clean water tanks, surge vessels, ventilation components.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">To be included in the price is the repeated measuring of the relevant structure and connection dimensions on site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Incl. updating to as-built drawings with all important dimensions established.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The contractor is liable for the correctness of his drawings as well as for the correct information on foundations, recesses, openings, shafts, ducts as well as empty conduits for small lines of mechanical and electrical installations, for measuring devices, etc.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Drawings of all built-in parts and mechanical installations</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">prepare at a scale of 1:50 or larger, as CAD colour plot</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">and on CD-ROM or USB stick in DWG/DXF format as well as in pdf format.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Timely submission of the assembly / fabrication drawings step by step according to the planned construction progress or by the contractually fixed individual deadlines. They are binding only after approval by the client.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inclding preparation and submission of a construction schedule with detailed construction sequence plan stating the essential prerequisittes for the individual sub-steps. Regular revision and updating according to construction progress. The construction schedule, status detailed design, is made available as a basis.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Handover in a single copy.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Billing as lump sum.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schedule, assembly and [PERSON_118]</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id191" RNoPart="5"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The electrical switchgear is tendered as a seperate trade, so that cooperation with the electrical engineering contractor is absolutely required.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">This comprises the following minimum scope:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1. Technical documents:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Handover of the technical documents of all units / measurements /signal transmitters / etc. with interfaces to electrical engineering and contains the following information:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Power connection (connected loads, such as rated power, starting method, rated current as well as specifications for protective devices, e.g. torques, max. currents etc.)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Control contacts</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Measurement signals, measuring ranges</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Connection diagrams</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">all other information concerning electrical engineering.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The documents must be handed over for each unit / measurement as a stand-alone paper document / pdf file, and have an unambiguous plain-text designation, as well as a cross-reference to the item no. in the mechanical engineering LV and the P&amp;I diagram.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">In addition, the units, measurements, etc. are clearly arranged in an </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">equipment list </span><span style="font-size:10pt;font-family:Arial;">in compiled form.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">If required, the proces diagram is also made available for the electrical engineering trade for this purpose.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2. Functonal description of individual unts / measurements</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Handover of a detailed functional description of all individual units / measurements / signal transmitters, etc. as "</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">functional specification</span><span style="font-size:10pt;font-family:Arial;">" for program creation (PLC programming).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3. Functional description of overall plant</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Handover of a detailed functional description of the overall plant with the interaction of all units / measurements / signal transmitters / etc. as "</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">functional specification</span><span style="font-size:10pt;font-family:Arial;">" for program creation (PLC programming) as well as as [ORT_016] of the operating manual.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The equipment list is to be submitted promptly after award of the contract, in order to be able to release components with a long delivery time for ordering on the basis of the essential technical data.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Functional specification and handover of electrical engineering documents</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id192" RNoPart="6"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Revision and supplementing of the flow diagrams, drawings, plant descriptions etc. prepared in the course of the measure into a comprehensive as-built documentation, functional and operating description of the entire mechanical equipment, described and drawn in detail,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">unless already included in item "Schedule, assembly and [PERSON_118]".</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Supply in triplicate as a loose-leaf collection, filed in binders. Additionally on data carrier in Windows-readable formats (preferably "pdf files").</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The description must describe the plant in its function, its correct operation and maintenance for normal operation. For the case of a malfunction, measures for eliminating immediate danger are to be stated, and the ways of purposefully searching for the cause of the malfunction and the remedying of simple malfunctions are to be explained. The functional description is to be submitted at the latest for the instruction of the operating personnel in the plant function.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Scope and execution is agreed with the AG after award of the contract, on the basis of the assembly planning and its updating to as-built drawings as well as the agreements made in the course of the assembly planning, incl. all required drawings and lists, to be supplied and handed over at  instruction of the operating personnel before acceptance of the plant.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Incl. the technical documents of all auxiliary units, valves, etc., TÜV reports, bacteriological proofs.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">To be included in the price are:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Related preliminary discussions with the AG about content, form and number of the documents to be supplied,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">the possibly required standardisation of the documentation to be supplied in the case of consortia or subcontractor services,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">the instruction of the AG's personnel in the documentation</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Billing as lump sum.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Documentation with functional and operating description</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id193" RNoPart="7"><Qty>200.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">All process components such as apparatus, machines, devices, valves and pipelines are to be fitted with identification plates.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Designations of the apparatus, machines, devices, valves and pipelines in plain text (kind or [PERSON_129], size and function) and with identifications according to P&amp;I flow diagram acc. to DIN EN ISO 10628.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The plates must be attached so as to be clearly visible and be largely UV-stable, insensitive to heat and cold, resistant to chemicals and scratch-resistent.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Plates including holder, material plastic, with grooves for sliding in the lettering, black lettering on white background, transparent cover.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Plate size: not smaller than 10 x 5 cm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Font size not smaller than 7 mm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Billing per piece</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Plant identification</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id194" RNoPart="8"><Qty>10.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Changes to assembly drawings, functional descriptions, other documentation at the instigation of the AG.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The following services can only be billed if the AG, after his approval of the respective assembly planning, documentation etc. to be provided by the AN, orders changes or additions to the same.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">If changes / additions to the assembly planning services are necessary because only after their approval (in the course of execution) a faulty or incomplete execution of the assembly drawings for which the contractor is at fault comes to light, the costs for the resubmission of the assembly planning services are borne by the contractor.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The work for the periodic updating of the construction schedule to be prepared by the AN is not paid separately.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Changes to fabrication drawings, etc.</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id195" RNoPart="02"><LblTx><p><span>Commissioning, proofs and maintenance</span></p></LblTx><BoQBody><Itemlist><Item ID="id196" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Professional disinfecting and subsequent flushing of all plant components in contact with drinking water within the scope of supply, incl. pumps, surge vessels, filter vessels and clean water tanks and other units and valves, for commissioning with proof of freedom from germs by a certified laboratory.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Required are at least 3 samples in succession with negative biological findings (scope of examination Pseudomonas aeruginosa, [PERSON_160] bacteria, Escherichia coli, enterococci, culturable microorganisms as colony count at 22 °C and 36 °C).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The proof samples are to be taken at the raw water inlet and at the clean water outlet of the waterworks (i.e. 3 samplings at 2 sampling points each).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Execution in several stages according to the requirements of the plant configuration.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The billing of any further disinfections that may be required is on the basis of actual expenditure against proof, but only insofar as the contractor is not responsible for the renewed disinfection.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Note on vessel disinfection (filters):</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The disinfection of the filter bed of the arsenic removal filters is dealt with in a separate item in the division "Equipment arsenic filters".</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The AN alone is responsible for the harmless removal of the waste water including any neutralisation that may be required.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">It is to be taken into account that the site drainage (wastewater) is by means of a lifting station, which is designed for a delivery rate of approx. 8 m3/h. The disposal of larger quantities of waste water may therefore involve a greater expenditure of time, unless buffer tanks for intermediate storage of waste water are kept available on site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">For the period of disinfection it is to be assumed for the cost estimate that no valves are electrically connected yet, i.e. corresponding expenditure of time for manual on-site operation is to be included in the price and is not paid separately.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Disinfectant e.g. [PERSON_065] or equivalent.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Disinfection of the overall plant</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id197" RNoPart="2"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Commissioning and trial operation of all units (e.g. treatment plant, booster pumps), valves and other functional units of this bill of quantities.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">After the end of the assembly (hydraulic/electrical) an inspection walk takes place.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The end of assembly is to be notified in writing to site management. The determination of the end of assembly relates only to the visual assessment. In doing so the completeness of the scope of supply and of the execution is checked.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">After successful determination that the assembly is finished, commissioning takes place, which is to be notified in writing to site management.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Commissioning and assembly are separate from each other in time. Commissioning can only take place after completion of the electrical equipment. The resulting costs for the renewed travel of the required personnel are to be included in the EP incl. all ancillary costs, away-from-home allowances, travel costs etc.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In doing so the following tests are carried out:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pressure test of the overall plant. DIN EN 805 / DIN 4279,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Test pressure according to requirement PN 10 for all plant components in the inlet of the clean water tanks / test pressure PN 16 for all plant components from the clean water pumping station onwards. The proof is to be documented in writing.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Checking of the equipment setup, optimisation of the place of installation</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trial run until the intended operation of all plant components is proven.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Commissioning takes place at the same time as the AN electrical engineering and is divided into:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Individual commissioning for all units / measurements incl. setting and adjustment of all required mechanical and electrical parameters.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Commissioning of the entire plant in connection with the interaction of all units / measurements / signal transmitters etc., incl. setting and adjustment of all required mechanical and electrical parameters. During commissioning the PLC program is to be optimised.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">For this, independent coordination of dates with the AN electrical engineering.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">After commissioning has taken place a trial operation is carried out.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">With the trial operation, intensive support of the operator's personnel (at least 1d/week) is to be provided for the duration of 4 weeks.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">To be included in the price are all required measuring devices, personnel, aids and travel costs.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">It is pointed out that interruptions of the trial operation for which the AN is responsible result in a corresponding extension of this trial operation. In the case of larger interruptions the trial operation is aborted and is to be started anew from the beginning after the problems have been remedied.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Basic settings changed in run-in / optimisation operation are to be documented in a commissioning report.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The aim during this period is to optimise the expenditure on personnel and energy. Furthermore the automation is to be coordinated with the telecontrol system (fault messages etc.).</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Commissioning and trial operation</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id198" RNoPart="3"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The functional capability of the treatment plant is to be proven by sampling. For this the following analyses of an independent and certified laboratory are to be submitted:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In total 3 times at an interval of two weeks until the end of the trial operation a small chemical-technical analysis with microbiology raw water and clean water (after treatment)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The following values are at least to be determined in each case:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Temperature and pH on site</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Calcite dissolution capacity</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Arsenic</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Turbidity</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">CO2</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Oxygen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Odour</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Freedom from germs ([PERSON_160] bacteria, Escherichia coli, enterococci, culturable microorganisms as colony count at 22 °C and 36 °C).</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Analytical proof of guaranteed values</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id199" RNoPart="4"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Handover of the completed overall plant to the operating personnel with instruction in operation and maintenance of all units, such as pumps, valves, measuring devices, etc.,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">the final sequence diagram,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">the switchgear with circuit diagrams, insofar as these are subject of this LV,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">the fault remedying.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The instruction takes place separately in time from commissioning and assembly. The resulting costs for the renewed travel of the required personnel are to be included in the EP incl. all ancillary costs, away-from-home allowances, travel costs etc.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Instruction of the operating personnel</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id200" RNoPart="5"><Qty>4.000</Qty><QU>Jahr</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maintenance contract for all maintenance-relevant plant components of this bill of quantities for the duration of the warranty period.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">With conclusion of the maintenance contract the period of the warranty is extended to 4 years.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The maintenance contract includes the following services to be carried out annually:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1. Inspecting the plant.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2. Maintaining the plant.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3. Supplying and replacing the wearing parts of the plant required for faultless function and operational safety, whose service life under usual operating conditions falls short of the warranty period; incl. proper disposal of the old parts and materials.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4. Supplying or providing all aids needed (e.g.  measuring devices, tools) and auxiliary materials (e.g. lubricants and cleaning agents), including ladders and vehicles.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In good time before acceptance a detailed maintenance contract in [PERSON_097] is to be submitted to the AG.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The EP offered covers the period between acceptance and end of the warranty period, i.e. four years.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Billing outside the final invoice, in each case after expiry of one year.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The maintenance contract is commissioned separately after acceptance according to the unit price offered here.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maintenance contract</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id201" RNoPart="03"><LblTx><p><span>Hourly-rate work (daywork)</span></p></LblTx><BoQBody><Itemlist><Remark ID="id202"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ADDITIONAL TECHNICAL CONTRACT CONDITIONS</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1) Hourly-rate work may only be carried out after written or verbal commissioning by site management. This agreement has to be made before the work is carried out. The hours incurred must be submitted every working day on separate report sheets and daywork reports for countersignature. Daywork hours that are not signed and are submitted later are not recognised subsequently and thus not paid.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2) In the hourly billing rates all wage-related overheads, surcharges, away-from-home allowances, travel money as well as the supervision and the costs for the basic tools customary in the trade are to be included.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3) In the billing rates for materials, machines and waste containers all overheads for transport, storage and mark-ups for general costs etc. are to be included.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4) The materials and equipment uses arising in the course of dayworrk are to be submitted every working day on the daywork slips, together with the hours incurred, to the local site management for approval and countersignature. Materials and equipment uses not approved in this form are not paid.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">5) Billing takes place in the course of the monthly interim invoices.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Additional Technical Contract Conditions</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id203" RNoPart="1"><Qty>5.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Engineer, project manager</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Payment is made only upon special order of site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">management. Daywork hours incurred must be confirmed by site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">management daily, otherwise no payment</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">is made.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Otherwise as described in the Additional Technical</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Contract Conditions.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Engineer, project manager</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id204" RNoPart="2"><Qty>10.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Foreman or chief fitter on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Foreman- or chief fitter</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id205" RNoPart="3"><Qty>10.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">[PERSON_020] on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Skilled worker hour</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id206" RNoPart="4"><Qty>5.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Construction helper on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Construction helper or labourer hours</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id207" RNoPart="5"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Small van on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with driver,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Small van payload 1,0 to with operator</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id208" RNoPart="6"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Welding machine on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with operator,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Welding machine electric with operator</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id209" RNoPart="7"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hammer drill on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with operator,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hammer drill 1500 Watt with operator</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id210" RNoPart="8"><Qty>2.000</Qty><QU>h</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Angle grinder on daywork,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with operator,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">otherwise as before</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Angle grinder 2000 Watt with operator</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id211" RNoPart="9"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Travel to an from site of the assembly personnel</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Travel to an from site of the assembly personnel</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id212" RNoPart="10"><Qty>100.000</Qty><QU>kg</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Section steel in [PERSON_115] V2A,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">in various profiles, sizes and dimensions.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Processing according to specified design drawings or as required, incl. all approved fastenings</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Section steel</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy></BoQBody></BoQCtgy><BoQCtgy ID="id213" RNoPart="02"><LblTx><p><span>Dismantling works</span></p></LblTx><BoQBody><BoQCtgy ID="id214" RNoPart="01"><LblTx><p><span>Dismantling of pipelines</span></p></LblTx><BoQBody><Itemlist><Item ID="id215" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dismantling, carrying out and disposal of the existing pipelines, valves and fittings incl. fastenings and necessary separating cuts in the pipe basement and ground floor of the existing treatment plant.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The dismantled valves are reused where possible. The dismantling and reassembly of these valves is taken into account separately in the division "Shut-off and safety devices".</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The removal of wall penetrations of pipelines that are no longer needed takes place in the builder's works trade.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;font-family:Arial;">Length of pipelines:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 100 and smaller approx. 10 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 125 approx. 15 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 150 approx. 35 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">DN 200 approx. 50 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pipelines of cast steel. Flange connections on average every 2 m.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pipeline fastenings/supports of concrete.are demolished by otthers on site after the pipeline dismantling.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Carrying out via stairs (see drawings). With regard to handling and accessibility the building description including the photos of the old existing structures contained there is to be observed. An on-site visit in the course of bid preparation is recommended. Lifting gear and assembly openings are not present in the existing structures.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Including provision of the required containers and disposal.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The suction-side stainless steel piping of clean water pumping station and backwash pump as well as the pressure-side stainless steel piping of the clean water pumping station are retained.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dismantling, carrying out and disposal of the existing pipelines</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id216" RNoPart="02"><LblTx><p><span>Removal of filer material and internals</span></p></LblTx><BoQBody><Itemlist><Item ID="id217" RNoPart="1"><Qty>30.000</Qty><QU>m³</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The two open dolomite filters are converted to arsenic removal filters.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The filter matierial of half-burnt dolomite installed so far is to be removed and disposed of.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Extract material with suction truck and dispose of.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Removal and disposal of filter filling</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id218" RNoPart="2"><Qty>4.000</Qty><QU>m³</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Removal and disposal of the supporting layers - presumably quartz gravel - from the aforementioned open dolomite filters.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Extract material with suction truck and dispose of.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Removal and disposal of supporting layers in dolomite filter</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id219" RNoPart="3"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Provision of the containers for the disposal of the extracted filter material including supporting layers,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">analysis of each batch according to Landfill Ordinnance / declaration analysis.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dewatering containers and sampling acc. to DepV</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy></BoQBody></BoQCtgy><BoQCtgy ID="id220" RNoPart="03"><LblTx><p><span>Units and machines</span></p></LblTx><BoQBody><BoQCtgy ID="id221" RNoPart="01"><LblTx><p><span>Pumps</span></p></LblTx><BoQBody><Itemlist><Remark ID="id222"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The representation of the pumps in the enclosed drawings is only by way of example and can deviate from the following item texts. With the bid, meaningful data sheets (characteristic curve, overall efficiency of pump at the operating point, motor data etc.) and dimensional drawings are to be submitted in every case. The same applies to alternative bids.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The bidder must check and ensure that the pumps offered can be installed in the space available and that the accessibility for maintenance work is guaranteed and the necessary calming sections before/after valves and measuring devices are complied with. The line routing may to that extent deviate from the line routing shown in the drawing enclosures. Nominal diameters of suction and pressure lines and of the valves installed in them may however not be reduced.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bid conditions pumps</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id223" RNoPart="1"><Qty>4.000</Qty><QU>St</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Glanded close-coupled pump</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Single-stage [PERSON_054] in [PERSON_185] design for</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">foundation installation including foot on the pump casing.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Low-vibration and low-noise close-coupled design with lantern and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">rigidly connected standard motor (norm motor).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">With forced-flushed bellows</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mechanical seal independent of direction of rotation (from 37 kW/4-pole optionally with a cartridge mechanical seal in back-pull-out system for</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mechanical seal replacement without dismantling the motor) and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">cavitation-reducing impeller.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flanges with pressure measuring connections R 1/8. All</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">grey cast iron components are cataphoresis-coated.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumps with motors &gt; 5,5 kW have as standard</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PTC thermistor sensors as motor protection.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The motor terminal box &lt; 7,5 kW can be of metal or plastic.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The motor terminal boxes &gt; 7,5 kW are always of metal.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Mechanical seal for water conveyance up to Tmax. = +140°C.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pump suitable for operation on frequency converter provided by others on site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Operating data</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Pumped medium:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Drinking water</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Media temperature: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">10 to 30,00 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Requested [PERSON_094]:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">60,00 m3 /h</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Requested delivery head:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">6,30 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Min. media temperature:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">5 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Max. media temperature:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">40 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Min. ambient temperature: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">0 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Max. ambient temperature: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">40 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Maximum operating pressure:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">16 bar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Minimum efficiency index (MEI): &gt; 0.4</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Motor data</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motor efficiency class:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">min. IE3</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Mains connection:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">3~400V/50 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Voltage tolerance:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">+-10 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Rated motor power:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">1,5 kW</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Rated speed:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">1450 1/min</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Rated current:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">3,6 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Power factor:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">0,71</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motor efficiency 50 %:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">81,3 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motor efficiency 75 %:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">83,4 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Motor efficiency 100 %:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">84,6 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Insulation class: F</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Degree of protection: IP55</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Motor protection: no</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Materials</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Coatings:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">suitable for drinking water</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Impeller:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">EN-GJL-200</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Shaft:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">1.4122</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Shaft seal:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">AQ1EGG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Lantern:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">5.1301/EN-GJL-250</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Installation dimensions</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Suction-side pipe connection: DN 80 , PN 16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pressure-side pipe connection: DN 65 , PN 16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Pump manufacturer:	</span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">'.........................................................'</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 124px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">(Wilo or equivalent)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">[PERSON_129] pump:	</span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">'.........................................................................'</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:113px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">(e.g. </span><span style="font-size:10pt;font-family:Arial;">Atmos GIGA-B 65/150-1,5/4 or</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:113px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">equivalent)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">A meaningful data sheet of the pump offered with all relevant information on operating data, pump hydraulics, drive, efficiency and materials is to be enclosed with the bid!</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Supply pump and assemble ready for operation.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">[PERSON_090] / [PERSON_066]</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id385" RNoPart="2"><Qty>4.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The pump according to the preceding item (intermediate pressure boosting arsenic removal filters and [PERSON_066]) is to be installed before the concrete foundation for the pump is produced.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">To be offered is a sturdy base frame of steel sections / threaded rods acc. to [PERSON_125] of the bidder for the assembly of the pump 30 cm above floor, suitable for subsequent grouting with concrete.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Securing in position by dowelling to the concrete floor.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">[PERSON_092]</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id225" RNoPart="3"><Qty>1.000</Qty><QU>St</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Glanded close-coupled pump</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Single-stage [PERSON_054] in [PERSON_185] design for</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">foundation installation including foot on the pump casing.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Low-vibration and low-noise close-coupled design with lantern and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">rigidly connected standard motor (norm motor).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">With forced-flushed bellows</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mechanical seal independent of direction of rotation (from 37 kW/4-pole optionally with a cartridge mechanical seal in back-pull-out system for</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mechanical seal replacement without dismantling the motor) and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">cavitation-reducing impeller.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flanges with pressure measuring connections R 1/8. All</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">grey cast iron components are cataphoresis-coated.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pumps with motors &gt; 5,5 kW have as standard</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PTC thermistor sensors as motor protection.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The motor terminal box &lt; 7,5 kW can be of metal or plastic. The motor terminal boxes &gt; 7,5 kW are always of metal.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Mechanical seal for water conveyance up to Tmax. = + 140°C.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Operating data</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Pumped medium: </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">Drinking water 100 %</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Media temperature:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">10 - 20,00 °C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Requested [PERSON_094]:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">21,00 m 3 /h</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:75px 151px 183px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px;"><span style="font-size:10pt;font-family:Arial;">Requested delivery head:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </spa