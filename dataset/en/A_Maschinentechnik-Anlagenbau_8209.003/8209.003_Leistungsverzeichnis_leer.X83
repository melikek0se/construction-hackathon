t><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pressure gauge valve DN 15</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id362" RNoPart="8"><Qty>2.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">C-Storz coupling 2 inch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mat: stainless steel, with external thread, blank cap and chain</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">supply and assemble</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Storz-C coupling (stainless steel)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id363" RNoPart="9"><Qty>2.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">B-Storz coupling 3 inch</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mat: stainless steel, with external thread, blank cap and chain</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">supply and assemble</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Storz-B coupling (stainless steel)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id364" RNoPart="10"><Qty>1.000</Qty><QU>St</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Solenoid valve 2" servo-controlled with 230 volt coil</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">For use in the drinking water sector,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Closed when de-energised.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The specified minimum pressure must always be present as differential pressure for faultless functioning of the servo control</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Installation position: any</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Seal: with drinking water approval</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Medium temperature: -10°C to +80°C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">With solenoid coil and device plug</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Voltage: 230 volt, 50 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Degree of protection: IP65</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fast closing</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Permissible pressure: 0,3 - 20 bar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Working with min. 0,3 bar pressure difference</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Valve closed in rest position (NC). When energised, the solenoid coil opens the pilot bore and the pressure on the upper side of the diaphragm is relieved. The now higher pressure under the diaphragm lifts it off the valve seat. The specified minimum pressure must always be present as pressure difference.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Size:DN 50 (2")</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Manufacturer:	 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">'...........................................'</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:18px 37px 75px 113px 151px 189px 226px 264px 302px 340px 378px 415px 453px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">(e.g. GSR or equivalent)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">[PERSON_129]:		 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">'...........................................'</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:18px 37px 75px 113px 151px 189px 226px 264px 302px 340px 378px 415px 453px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Connection R internal:DN 50 (2")</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Solenoid valve DN 50</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id365" RNoPart="11"><Qty>1.000</Qty><QU>St</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sampling basin of stainless [PERSON_089] (1.4571)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with slightly sloping bottom;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with 6 pieces of sampling valves DN 15, flame-sterilisable, with</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">connection nipple G 1/2 inch, design in [PERSON_115],</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">make / [PERSON_129]: Elomat PROHA 1 or equivalent</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Labelling per sampling point with engraved [PERSON_013] (e.g. Resopal plate),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">with rear sheet metal for assembly of the sampling valves; </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">as splash guard: </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">cover screen for basin surface and lateral guard plates;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">incl. line connection DN 50 in the bottom of stainless steel for connection to drain line DN 50 (press-fitting pipeline)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Prepared for assembly on reinforced concrete wall or plastered brick wall incl. wall brackets.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Basin depth:		 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">'..............................'</span></ComplBody><ComplTail><span style="font-family:Arial;font-size:10pt;"> mm</span><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:48px 96px 144px 192px 240px 288px 336px 384px 432px 480px 529px 576px 624px 672px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">(min. 200 mm)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="12" Kind="Bidder"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Basin width:		 </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">'..............................'</span></ComplBody><ComplTail><span style="font-family:Arial;font-size:10pt;"> mm</span><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;tab-stops:48px 96px 144px 192px 240px 288px 336px 384px 432px 480px 529px 576px 624px 672px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">(min. 900 mm)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">A detailed construction drawing of the [PERSON_046]s is to be submitted to site management in good time before fabrication for checking and approval.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">supply and assemble.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sampling station</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id366" RNoPart="12"><Qty>10.000</Qty><QU>St</QU><Description><CompleteText><ComplTSB>Yes</ComplTSB><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sampling valve of [PERSON_115],</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">for sampling points that cannot be routed to the central sampling station,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">for simple and professional sampling. Needle valve technology with metal-to-metal sealing prevents microbial contamination and ensures high flow during sampling.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Outlet with welded-on 90° bend, 15mm diameter.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:397pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">The valve is flame-sterilisable up to 200°C.</s