                          <ArtChrIdent>9567</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>9153</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                        <STLBBauID>
                          <ArtChrIdent>10164</ArtChrIdent>
                          <ArtChIdx>0</ArtChIdx>
                          <ChVIdent>1</ChVIdent>
                        </STLBBauID>
                      </STLBBau>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Trunk protection by 40 mm thick plank casing incl. padding against the tree, trunk circumference measured at 1 m height over 0,5 to 1 m, minimum distance from the trunk 10 cm, minimum height 2 m, construct.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Trunk protection casing planks padding U 0,5-1m H 2m </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">construct</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I50" RNoPart="12">
                    <UPBkdn>No</UPBkdn>
                    <Qty>3</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Protection of the existing pole-mounted luminaires by stake tripod with two frames of half-round timbers or boards, stake length 250 cm, minimum height 2 m, construct.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Height of first frame: approx. 1m above OK ground</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Height of second frame: 2m above OK ground</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Protection pole-mounted luminaire existing H 2m </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">construct</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="C8" RNoPart="2">
              <LblTx><span style="text-align:left; font-weight:bold; font-family:Arial; font-size:10pt">[ORT_030]</span><br/></LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R8">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">[ORT_030] sewer trench, pipe trench</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">[ORT_030] sewer trench, pipe trench</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R9">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-weight:bold; font-family:Arial">Ground conditions</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">A soil report is available for the directly neighbouring construction site NTC main building. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-weight:bold; font-family:Arial">Information on the homogeneous zones see annex no. 5</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">According to the report, the groundwater level in the area of the NTC construction field lies at depths between 290,00 m above NN to 289,53 m above NN. The surface of the construction site lies at approximately 293,90 m above NN.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">There are sandy cover layers, generally of medium density. </span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">The main pipeline route runs predominantly under the current fire brigade perimeter road, north of the central workshop and the IZNF,with a carriageway structure, paving and base courses in a thickness of approx. 60-70 cm.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Ground conditions, information on the homogeneous zones</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R10">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Preliminary remark billing width trench excavation</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Depending on the type of pipeline or type of cable, the minimum trench width according to DIN 4124 or DIN EN 1610 is billed. Billing vertical.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">In areas with formwork and shoring constructions, 2 x 15cm can additionally be billed on top of the width.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Preliminary remark billing width trench excavation</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R11">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Standard description</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Quantity determination of the soil movements by measurement at the</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">place of installation in installed condition.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Standard description</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="R12">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">Preliminary remark - earthworks and trench works - tree roots</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">small partial areas were or are at the start of construction stocked with</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">forest trees.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">During the [ORT_030] or trench works it is to be</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">assumed that at different depths</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">tree roots of the trees still present or of the</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">felled trees will be encountered.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">The cutting back of the larger tree roots is paid in a separate item.</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial">FAU - cooling network preliminary remark: earthworks and trench works, tree roots</span><span style="text-align:left; font-style:italic; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I51" RNoPart="1">
                    <UPBkdn>No</UPBkdn>
                    <Qty>25</Qty>
                    <QU>m3</QU>
