                      <SubDNo>1</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Welding on of pipe piece DN25, threaded steel pipe DIN EN 10255, min. 0,1 m, thread on one end, sealed screwing on of a brass bal valve with removable actuator, sealed screwing on of pipe piece DN25 0,15 m long with thread on both ends, tight closure of open end with screw cap of [PERSON_176], incl. complete wraping with corrosion protection tape for the welded-on additional equippment dished end.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Note: serves as filling device</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Additional equipment</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
