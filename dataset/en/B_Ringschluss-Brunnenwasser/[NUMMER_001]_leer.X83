                    <UPBkdn>No</UPBkdn>
                    <Qty>4</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Universal- support plate for valve box</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">of break-proof and stable plastic for receiving surface boxes acc. to DIN 4056 and DIN 4057 and for secure fixing of extension spindles, round, space-saving shape, with reinforcing ribs for taking up the road loads acting from above.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Material: polyamide, glass-fibre reinforced</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Installation height: 20 mm</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
