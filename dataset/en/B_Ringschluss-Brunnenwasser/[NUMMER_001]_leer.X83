                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Traffic sign acc. to StVO, supplementary sign no. 1000-22, size 1 acc. to traffic sign catalogue, with mounting device, with proof of stability, erect and dismantle.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Traffic sign supplementary sign 1000-22 size 1 erect </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">dismantle</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
