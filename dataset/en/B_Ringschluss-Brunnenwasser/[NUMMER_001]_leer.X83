                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Seepage element of PE for aeration and venting sets, consisting of a one-piece water-permeable drainage pipe for receiving and slowly draining off splash water which occurs during the venting process</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
