                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Pre-insulated shut-off valve DIN EN 488, as ball valve, for adjusting device, with spindle extension and protective pipe of PE-HD, for pre-insulated bonded pipeline DIN EN 253, as single pipeline, outside diameter inner pipe 273 mm, for [PERSON_044], max. operating temperature 130 deg C, max. operating overpressure 2,5 MPa (25 bar), insulation - standard.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Shut-off valve [PERSON_153]. [PERSON_052]</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"> AD 273mm [PERSON_044] 25bar</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                    <SumDescr>Yes</SumDescr>
                    <SubDescr>
                      <SubDNo>1</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">[PERSON_129] Broen DN 250 (273,0/400)</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Steel grade P235 GH, width across flats 27/70</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">welded acc. to EN 10217</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">PEHD casing, incl. IPS</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">reduced bore</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Ball of [PERSON_115], trunnion-mounted</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pressure rating PN 25</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">produced acc. to EN 488</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[PERSON_129] Broen DN 250</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                            </OutlTxt>
                          </OutlineText>
                        </CompleteText>
                      </Description>
                      <UPBkdn>No</UPBkdn>
                    </SubDescr>
                    <SubDescr>
                      <SubDNo>2</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Spindle extension [PERSON_129] [PERSON_115]</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"> / [PERSON_089] galvanised, can be shortened</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">medium width across flats 27/70mm, L = 2,00m,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">are suitable for use with gear unit,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">adjustment of spindle length in workshop and assembly planning</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Spindle extension [PERSON_115] / [PERSON_089] galvanised</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                            </OutlTxt>
                          </OutlineText>
                        </CompleteText>
                      </Description>
                      <UPBkdn>No</UPBkdn>
                    </SubDescr>
                    <SubDescr>
                      <SubDNo>3</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Protective pipe [PERSON_129] 3 DA 280/180</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">for shut-off valve DN 200 - DN 300</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">L = 3,0m, incl. push-on cap</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Protective pipe for shut-off valve</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                            </OutlTxt>
                          </OutlineText>
                        </CompleteText>
                      </Description>
                      <UPBkdn>No</UPBkdn>
                    </SubDescr>
