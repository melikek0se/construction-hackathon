                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Hydrant box of cast iron, walkable, as manhole cover, oval, with frame and cover, web for fastening the draw-off valve of the offered hydrant or the guide disc.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Dimensions:290mmx200mm</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Depth: 120mm</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
