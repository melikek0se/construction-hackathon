    <AddText>
      <OutlineAddText><span>Supplement to the bid request</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;font-family:Arial;">Supplement to the bid request</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Units used in this bill of quantities</span><br/><span style="font-size:10pt;font-family:Arial;">cm</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">centimetre</span><br/><span style="font-size:10pt;font-family:Arial;">cm2   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">square centimetre</span><br/><span style="font-size:10pt;font-family:Arial;">d     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">day</span><br/><span style="font-size:10pt;font-family:Arial;">h     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">hour</span><br/><span style="font-size:10pt;font-family:Arial;">Jr    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">year</span><br/><span style="font-size:10pt;font-family:Arial;">kg   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;"> kilogram</span><br/><span style="font-size:10pt;font-family:Arial;">km    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">kilometre</span><br/><span style="font-size:10pt;font-family:Arial;">km2   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">square kilometre</span><br/><span style="font-size:10pt;font-family:Arial;">kwh   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">kilowatt hour</span><br/><span style="font-size:10pt;font-family:Arial;">l     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">litre</span><br/><span style="font-size:10pt;font-family:Arial;">m     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">metre</span><br/><span style="font-size:10pt;font-family:Arial;">m2    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">square metre</span><br/><span style="font-size:10pt;font-family:Arial;">m3    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">cubic metre</span><br/><span style="font-size:10pt;font-family:Arial;">Mt    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">month</span><br/><span style="font-size:10pt;font-family:Arial;">psch  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">lump sum</span><br/><span style="font-size:10pt;font-family:Arial;">St    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece</span><br/><span style="font-size:10pt;font-family:Arial;">t     </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">tonne</span><br/><span style="font-size:10pt;font-family:Arial;">Wo    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">weeks</span><br/><span style="font-size:10pt;font-family:Arial;">md    </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m x day</span><br/><span style="font-size:10pt;font-family:Arial;">mMt   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m x month</span><br/><span style="font-size:10pt;font-family:Arial;">mWo   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m x week</span><br/><span style="font-size:10pt;font-family:Arial;">m2d   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m2 x day</span><br/><span style="font-size:10pt;font-family:Arial;">m2Mt  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m2 x month</span><br/><span style="font-size:10pt;font-family:Arial;">m2Wo  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m2 x week</span><br/><span style="font-size:10pt;font-family:Arial;">m3d   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m3 x day</span><br/><span style="font-size:10pt;font-family:Arial;">m3Mt  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m3 x month</span><br/><span style="font-size:10pt;font-family:Arial;">m3Wo  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">m3 X week</span><br/><span style="font-size:10pt;font-family:Arial;">Sth   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece x hour</span><br/><span style="font-size:10pt;font-family:Arial;">Std   </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece x day</span><br/><span style="font-size:10pt;font-family:Arial;">StMt  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece x month</span><br/><span style="font-size:10pt;font-family:Arial;">StWo  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece x week</span><br/><span style="font-size:10pt;font-family:Arial;">St/M  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece per month</span><br/><span style="font-size:10pt;font-family:Arial;">St/J  </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-family:Arial;">piece per year</span><br/><br/><span style="font-size:10pt;font-family:Arial;">End of the supplement to the bid request</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Further special contract conditions -  continuation of form 214 H</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Continuation of further special contract conditions</span><br/><span style="font-size:10pt;font-family:Arial;">see  form 214.H - Special contract conditions - </span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.1   Start of the work</span><br/><span style="font-size:10pt;font-family:Arial;">Start of the work within the meaning of form 214.H, no. 1 is the commencement of the tendered work. This also includes measurements, design work (e.g. workshop and assembly drawings) and investigations or preparatory work. These are to be submitted to the client on request.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.2    Change-order offers (§ 2)          </span><br/><span style="font-size:10pt;font-family:Arial;">All change-order offers, including the necessary supporting documents (cost estimates, measurements, etc.), are to be submitted in 1 copy to the client in legally valid form and at the same time in 1 copy to the engineering office for checking of the content.</span><br/><span style="font-size:10pt;font-family:Arial;"/><br/><span style="font-size:10pt;font-family:Arial;">10.3    Advertising of the company / site board (§ 4 para. 1)</span><br/><span style="font-size:10pt;font-family:Arial;">Company advertising is prohibited on the site as a matter of principle. </span><br/><span style="font-size:10pt;font-family:Arial;">This also applies to scaffolds, containers and protective devices. Exceptions require the written approval of the AG.</span><br/><span style="font-size:10pt;font-family:Arial;"/><br/><span style="font-size:10pt;font-family:Arial;">On the site board  provided by others on site  the contractor may have additional signs in the intended form put up at its own expense.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.4    Visiting of sites (§ 4 para. 1)</span><br/><span style="font-size:10pt;font-family:Arial;">The visiting of sites by third parties requires the prior consent of the client.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.5    Ban on overnight stays (§ 4 para. 1)</span><br/><span style="font-size:10pt;font-family:Arial;">A strict ban on overnight stays applies on the entire site</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6    Supplement to § 4 no. 4 VOB/B:</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.1  Connection options for construction water and construction power</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Construction water can be taken from the a hydrant east of Immerwahrstraße next to the footpath in the immediate vicinity of the  at the site, disstance approx. 100 m;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">2 fixed coupling B Din 14318.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">After the withdrawal the connection is to be properly shut off again. A suitable hose is to be brought along by the contractor. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The contractor has to apply for the withdrawal at the technical department of FAU. Meter, or as far as required standpipe, are to be provided by the contractor. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">The construction power supply is provided by others on site from building 114 (Materials Science building) east of Immerwahrstraße, in the immediate vicinity of the site, distance approx. 100 m.Connected load 400 V, fuse protection max 63 Amp.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">The work for the crossing of Immerwahrstraße </span><span style="font-size:10pt;font-family:Arial;">see "Site setup" on this.</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">10.6.2  The costs of consumption for power and [PERSON_029] are borne by the AG. Excepted are the costs for the AN's own needs (container supply etc.). These are to be borne by the AN. Corresponding sub-meters are to be installed by the AN. The meter readings (start and end of the period of use) are to be documented jointly with the site management of the AG.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.3  Necessary storage and working places are assigned by site management.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.4 No sanitary facilities are available on the site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Sanitary facilities are tosupply by the AN, see "Site setup" on this.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">The sanitary facilities are also used by a third parties</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.6.5 Storage and crew containers are not available from the client side. If the contractor needs these, they are to be supplied by it at its expense..</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.7    Use of subcontractors (§ 4 para. 8)</span><br/><span style="font-size:10pt;font-family:Arial;">For the work for which the AN's business is set up, the obligation of self-performance applies in the first instance under § 4 para. 8 VOB/B. Excepted from this are that subcontractors who were already named individually for specific partial work before the award of contract.</span><br/><span style="font-size:10pt;font-family:Arial;">Any change of subcontractor is to be approved by the client before the start of activities on the site. Any deviation from the subcontractors named for the award counts as a change.</span><br/><span style="font-size:10pt;font-family:Arial;">For the approval, the complete proofs of suitability according to form 124, as well as the self-declaration or a proof of entry in the list of the Verein für die Präqualifikation von [FIRMA_008] (prequalification register) are to be submitted for every single subcontractor in such good time that a proper check of the documents by the client is possible during usual business hours.</span><br/><span style="font-size:10pt;font-family:Arial;">A change of subcontractor is as a matter of principle only agreed to if there is a valid reason for a change of subcontractor. Such a reason is assumed if a termination of the previous subcontractor by the main contractor under § 8 VOB/B is justified.</span><br/><span style="font-size:10pt;font-family:Arial;">The contracts with subcontractors are to be concluded according to VOB/B. Breaches of this contract clause entitle the client to terminate for good cause and may lead to the loss of the prequalification. </span><br/><span style="font-size:10pt;font-family:Arial;">The award of work from the contract to sub-subcontractors is as a matter of principle not agreed to.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.8   Invoices (§ 14)</span><br/><span style="font-size:10pt;font-family:Arial;">All invoices are to be submitted in 1 copy to the client in legally valid form and at the same time in 1 copy, including the necessary supporting documents (measurements, billing drawing, etc.), to the engineering office for checking of the content. Invoices are to be designated according to their purpose as interim or final invoices.</span><br/><span style="font-size:10pt;font-family:Arial;">The invoices are to be drawn up cumulatively and consecutively. </span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.9   Ordering of hourly-rate work (§ 15)</span><br/><span style="font-size:10pt;font-family:Arial;">The hourly-rate work sheets are to be submitted weekly.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.10   Site manager</span><br/><span style="font-size:10pt;font-family:Arial;">A technically qualified German-speaking supervisor of the contractor must be present on the site at all times.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.11   Site meetings</span><br/><span style="font-size:10pt;font-family:Arial;">The contractor has to send an authorised German-speaking representative to the site meetings which the client holds regularly. </span><br/><span style="font-size:10pt;font-family:Arial;">The meetings each take place as coordinated at the start of construction.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.12  Health and safety plan</span><br/><span style="font-size:10pt;font-family:Arial;">For carrying out the measure, a health and safety plan is prepared by the AG and the SIGE coordinator.</span><br/><span style="font-size:10pt;font-family:Arial;">The AN has to inform its employees about the SIGE plan.</span><br/><span style="font-size:10pt;font-family:Arial;">The SIGE plan is to be observed and kept available in the company's site management.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.13  Handover of execution drawings</span><br/><span style="font-size:10pt;font-family:Arial;">The execution drawings are handed over in [PERSON_097]  and in digital form (PDF).</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.14  Production of drawings and documents</span><br/><span style="font-size:10pt;font-family:Arial;">- Requirements of the client -</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">As the basis for the design documents to be prepared by the contractor, the client makes the following documents available in digital form:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><br/><span style="font-size:10pt;font-family:Arial;">- P5_15145_F_07.043_LP-LTG_VAM-OST_[PERSON_133] existing + design</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.15   Production of drawings and documents</span><br/><span style="font-size:10pt;font-family:Arial;">- Formal requirements -</span><br/><span style="font-size:10pt;font-family:Arial;">The contractor has to produce the drawings and documents in conformity with standards. The drawings are to be made in a DIN A - format. The largest permissible format is DIN A 0.</span><br/><span style="font-size:10pt;font-family:Arial;">The client's drawing title block is to be used according to its instruction.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">- Surveying work, measurement procedure - </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">For all work of the AN, billing drawings and billing sketches are to be prepared on the basis of the working drawings handed over and handed over in 2 copies. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">The surveying work is to be set up in the UTM coordinate system.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:427pt;"><span style="font-size:10pt;font-family:Arial;">Separate measurement sheets are to be set up for each of the individual items. The laid pipelines and [PERSON_017] are to be measured digitally with regard to position and depth and handed over digitally in DWG format and PDF fromat  with point list to construction supervision. The handover of the digital [PERSON_118] must take place before final acceptance</span><span style="font-size:10pt;color:#FF0000;font-family:Arial;">.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.16   Construction schedule</span><br/><span style="font-size:10pt;font-family:Arial;">On the basis of the construction sequence plan submitted by the AG, the contractor has to prepare a construction schedule for its contractual work, by means of which compliance with the contract deadlines can be proven and monitored.</span><br/><span style="font-size:10pt;font-family:Arial;">The stipulations of the client, e.g. on the technical or scheduling coordination with the other work sections, are to be taken into account. In the event of changes to the contract deadlines or of considerable deviations from other stipulations, the plan is to be updated by the contractor without delay. The plan is to be handed over to the client 12 working days after award of the contract, in the case of revisions without delay, in each case in 2 copies.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">10.17   Acceptance</span><br/><span style="font-size:10pt;font-family:Arial;">A formal acceptance of the work is required.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">End of the further special contract conditions</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>ZTV information and other regulations</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:290pt;"><span style="font-size:12pt;font-weight:bold;font-family:Arial;">Additional Technical Contract Conditions (ZTV)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:290pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">Additional Technical Contract Conditions (ZTV)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">Additional technical contract conditions</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">within the meaning of § 1 para. 2 no. 4 VOB/B  are</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">- for [ORT_030]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">- for road and path construction construction works</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">- for landscaping works</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">regulated in form 9002.StB_ZTV of the VHB Bayern. The ZTV named there</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;">become part of the contract</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:454pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:290pt;"><span style="font-size:10pt;font-family:Arial;">End of the Additional Technical Contract Conditions (ZTV)</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>General construction description - civil works</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:12pt;color:#000000;font-weight:bold;font-family:Arial;">Construction description - civil works</span></p><p style="text-indent:-126pt;margin-left:126pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-141pt;margin-left:141pt;margin-top:0pt;margin-bottom:0pt;width:482pt;line-height:100%;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.    GENERAL DESCRIPTION OF THE WORK</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-28pt;margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.1   Construction project</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">D-[ORT_001] / Immerwahrstraßestraße  </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">New building New Technical Chemistry</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Preparatory works:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Addition [PERSON_132] - main route</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Addition well water line</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Addition [PERSON_132] - connection to structural works</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-21pt;margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.    INFORMATION ON THE SITE</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-21pt;margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.1  Location of the site</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">91058 [ORT_022], FAU campus South</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The site is located in at the south-eastern edge of the city of [ORT_022] on the campus of the Friedrich-Alexander University [ORT_022]-[ADRESSE_001] (FAU) east and west of Immerwahrstraße, along the fire brigade loop road on the north side of the IZNF building and the central workshop</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Within the construction field conditions are confined; existing trees at the side of the fire brigade loop road and the open areas of the institute buildings.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">[PERSON_133] see annex 1</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Site plan of the construction measure see annex 2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.2  Existing public traffic routes </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Access to the site is via Cauerstraße and Immerwahrstraße from the west.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.3 Construction measures taking place in parallel </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In parallel with the laying of the [PERSON_132] and the well water line, civil works for clearing the construction ground take place on the future construction plot NTC, west of Immerwahrstraße. These works take place mainly in the northern and western area of the construction field NTC.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Temporary use of the southern construction field NTC for the interim storage of earth material and pipe material is possible after coordination with the construction supervision and the construction company working on the construction field.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="text-indent:-28pt;margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.4  Earth dumps</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">There are two temporary interim storage areas for soil material on which, however, only raw soil and topsoil without any concrete parts or other demolition materials may be stored temporarily.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Soil storage 1:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Surplus raw soil which, in the course of the [ORT_030], is again </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">immediately</span><span style="font-size:10pt;font-family:Arial;"> needed can be stored temporarily west of Immerwahrstraße, opposite the junction of the fire brigade loop road, at a distance of approx.100 - 200 m in orderly stockpiles / heaps, in coordination with the construction supervision.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The storage area west of Immerwahrstraße is also used in parallel by a third-party company during the construction period. Digging works and temporary deposition of soil material take place here, therefore all activities on this area are to be coordinated beforehand with the construction supervision.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Soil storage 2:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">A further, temporary interim storage area for soil material that later, after sampling  must be disposed of, is located in a piece of woodland of the FAU at a distance of approx. 850 m; access to the interim storage area via Kurt-Schuhmacher-Straße, opposite Weißenseelinie (Tennenlohe forest).</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The path into the interim storage area itself is not paved </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Access to soil storage 2 see annex no. 3</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.5  Borrow pits and deposit site</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">For the filling works in the backfill zone, material from the pipe trench excavation is to be used as far as possible. Should thís excavated soil not be suitable then compactable raw soil is to be used that comes from a borrow pit in the construction field or from the temporary interim storage area on the campus of the FAU,</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.6  Protection zones and protected objects</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The existing trees outside the construction field must be preserved and protected accordingly. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.7  Installations in the construction area</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Existing supply and disposal facilities</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The position of existing lines, cables, drains, sewers and the like entered in the drawings serve only as information on the presence of lines and the like. Independently of the notes listed below, the contractor has to inform himself on his own and comprehensively, before the start of the construction works and if necessary also during the ongoing works, about the exact position and depth of any existing lines and the like at the installation operator or at the bodies responsible for the supply and disposal installations and, if necesary, have himself instructed in the line routes.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Electrical lines:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In the immediate construction area  electrical lines are known.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Telekom lines, telecommunication cables:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In the immediate construction area telecommunication lines are known.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Cooling lines:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">I</span><span style="font-size:10pt;font-family:Arial;">n the immediate construction area cooling lines are present. </span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Water lines:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In the immediate construction area water lines are known.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The well water line also runs in the construction area. Information on this line is available from the technical department of the FAU.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Sewer lines:</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">No wastewater lines are known in the construction field.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">2.8  Public traffic in the construction area</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In the surroundings of the construction field public traffic takes place - pedestrians and cyclists - for whom, however, diversions are set up.</span></p><p style="margin-left:21pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">End of the general construction description</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Technical information - civil works</span></OutlineAddText>
      <DetailAddText><p style="text-indent:-28pt;margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:37px 188px 302px 453px 604px 756px 831px 907px 982px 1058px 1134px 1209px 1285px 1360px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">. </span><span style="font-size:10pt;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">INFORMATION ON EXECUTION</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.1 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Traffic routing, traffic safety measures</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The access possibilities to the site for the fire brigade must be kept clear. </span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The AN must set up his site in such a way that at the weekend and at night when the site is not staffed alternating accesses for the fire brigade are possible.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The contractor has to ensure traffic safety on the site; this also applies to the immediately adjoining areas, insofar as he has created a danger spot in these areas through the site operation or could possibly cause one through his construction operation.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The contractor has to ensure on his own, daily, that the footpaths and carriageways soiled by his construction operation are cleaned.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The site itself is likewise to be operated in an orderly manner, in particular at the end of the working day and at weekends the site is to be left orderly and cleaned of waste etc. and secured against unauthorised entry.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Traffic law order</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Although the construction sitte as a whole is private land of the FAU, a traffic law order is required. The contractor has to apply for this at the city of [ORT_022] and keep the traffic law order permanently available on site during the construction period.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">For the construction measure, barriers and safeguards effective under traffic law are to be provided also within the semi-public areas. </span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Necessary barriers and signage as well as their construction-related changes during the construction period are described in the bill of quantities.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.2 </span><span style="font-size:10pt;font-weight:bold;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Construction sequence</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In a first stage the new [PERSON_132], together with the well water line, is to be constructed.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">In a second stage, offset in time, the [PERSON_132] between the section already laid under Immerwahrstraße and the basement of the structural works NTC is then to be constructed. This work can only take place when the basement of the new building is completed. Between the end of the construction works for main route [PERSON_132] and the start of the  connection works to the structural works there are approx. 9 months - execution August 2024.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.3 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Dewatering</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">According to the soil report the groundwater occurs below the base of the subsoil. In order to intercept any [PERSON_149] that may occur, the bill of quantites contains work for dewatering. The [PERSON_029] that may have to be pumped off can be pumped on the east side of Immerwahrstraße into an infiltration basin north of the IZNF building. Under this infiltration basin there is an infiltration trench for the infiltration of precipitation water.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.4 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Preservation of evidence</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Before the start of construction a joint inspection is carried out with the contractor and the client's construction supervision to document the condition of the site. The inspection is documented jointly by means of photo documentation and minutes.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.5 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Safeguarding measures / site safeguarding</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The construction field, is to be closed off with a site fence.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Because the pipe trench is open for a longer time it is to be closed off in such a way that pedestrians are protected in any case.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;background-color:#000000;font-weight:bold;font-family:Arial;"/></p><page/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.6 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Daily construction reports</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The contractor has to keep daily construction reports and hand them over to the client daily. The daily construction re- ports must contain all information that can be of importance for the execution and billing of the contract.</span></p><p style="margin-left:26pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:38px 756px 831px 907px 982px 1058px 1085px 1132px 1180px 1227px 1274px 1321px 1368px 1416px;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">1.7 </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"/><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Tests</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">For the specified compaction work and for all backfilling works, compliance with the required compaction values is to be documented and proven in writing by the AN immediately after completion.</span></p><p style="margin-left:28pt;margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">End of the technical information</span></p></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>General description of the technical installations [PERSON_127]</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">T</span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">echnical installations [PERSON_127] in outdoor facilities</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><br/><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Ring closure well water line</span><br/><br/><span style="font-size:10pt;font-family:Arial;">The well water line is  newly laid in the entire area of the cooling route and the ring closure is thereby produced. A new tapping point (underground hydrant DN50) is built near the path in front of building 114.01 Materials Science. </span><br/><br/><span style="font-size:10pt;font-family:Arial;">The connection to the main supply line DN160 in Immerwahrstraße is made by tapping under the operating pressure.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">The interruption of operation required for the connection is to be announced at least 1 week beforehand to the</span><br/><span style="font-size:10pt;font-family:Arial;">operations engineering department and the [FIRMA_001].</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">The works for the pipe connection lead to an interruption of operation. The existing line must be</span><br/><span style="font-size:10pt;font-family:Arial;">shut off and drained. The gate valve is not located directly in the connection area,</span><br/><span style="font-size:10pt;font-family:Arial;">but at the pipe branch at Cauerstraße. The connection to the supply line PE 2", on the eastern side of the ring closure, is made by installing a T-piece in the main supply line.</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Cooling installations, connection cooling network</span><br/><span style="font-size:10pt;font-family:Arial;">For the cooling supply of the NTC the connection lines are prepared in the outdoor area.</span><br/><span style="font-size:10pt;font-family:Arial;">The connection is made to the cooling network in the dimension DN 250.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/><br/><span style="font-size:10pt;font-family:Arial;">The connection to the property network is made at an existing outlet between the [ADRESSE_011] (118.01 central workshop) and 6 (115.01 Electrical Engineering). Laying takes place between the [ADRESSE_011] (118.01 central workshop)  and [ADRESSE_015] (114.01 Materials Science) as far as Immerwahrstraße. In the area of Immerwahrstraße the connection of the building "New building Technical Chemistry" is prepared and a provision for further construction is made. The pipes are laid in the ground in the outdoor area. </span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">End of the construction description</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"/></DetailAddText>
    </AddText>
    <AddText>
      <OutlineAddText><span>Technical information - [PERSON_127]</span></OutlineAddText>
      <DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Technical information</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Fixing of pipelines/brackets etc.</span><br/><span style="font-size:10pt;font-family:Arial;">The fixing of pipelines, cable routes, brackets etc. also includes the drilling of holes and all required approved fixing materials. </span><br/><span style="font-size:10pt;font-family:Arial;">This work is to be included in the price of the respective items.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Waste material</span><br/><span style="font-size:10pt;font-family:Arial;">From the area of the AN (site waste, e.g. packaging material, residual materials etc.) is to be disposed of in accordance with the legal regulations (e.g. local waste statutes). Recyclable materials are to be separated out, collected in separate fractions and passed on for recycling. (Ancillary work acc. to no. 4.1.11  DIN 18 299).</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Before acceptance the AN has to fulfil the following general work:</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Documentation</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;">Without special payment:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Commissioning and trial operation of the installation</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Instruction of the operating personnel</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Handover of the following documents to the AG (3 copies):</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;"><span style="font-size:10pt;font-family:Arial;">Lists of spare parts and special aids to be kept available as well as their sources of supply.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><br/><span style="font-size:10pt;font-family:Arial;">Against payment, according to separate LV items:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;line-height:100%;"><span style="font-size:10pt;font-family:Arial;"/></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Defect-free acceptance, test and approval documents including the records of measurements carried out</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Operating, service and maintenance instructions incl. note on intervention in the event of a fault</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Description of installation and function of the entire installation as well as individual units or complex components with overview drawings, techn.data sheets and schematics</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">As-built drawings of the routing of cables, lines, ducts and routes as well as of the places of installation or  erection of the installations and their components with details of the performance data and item numbers of essential installation parts, required individual drawings such as flow, circuit schematic, circuit, terminal overview diagrams and the like (DIN-compliant) paper DIN A4, in the folder in triplicate.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_118] as described before, but as cad - file in the format *.dwg and *.pdf.</span><br/><span style="font-size:10pt;font-family:Arial;">The structure of the execution drawings must be retained, in particular the layer structure, external references, drawing unit, insertion point and the file name convention</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><br/><span style="font-size:10pt;font-family:Arial;">End of the technical information</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:491pt;line-height:100%;"/></DetailAddText>
    </AddText>
    <BoQ ID="B273960">
      <BoQInfo>
        <Name>[NUMMER_001]</Name>
        <LblBoQ>RING CLOSURE WELL WATER, [PERSON_132]</LblBoQ>
        <Date>2023-03-10</Date>
        <OutlCompl>AllTxt</OutlCompl>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <LblBoQBkdn>Division</LblBoQBkdn>
          <Length>2</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <LblBoQBkdn>Section</LblBoQBkdn>
          <Length>2</Length>
          <Num>Yes</Num>
        </BoQBkdn>
        <BoQBkdn>
          <Type>Item</Type>
          <LblBoQBkdn>Item</LblBoQBkdn>
