                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Dished end Klöpper form carbon steel welding </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[PERSON_044] AD 273mm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
