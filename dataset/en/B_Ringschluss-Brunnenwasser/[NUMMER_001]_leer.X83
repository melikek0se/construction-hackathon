                      </STLBBau>
                      <CompleteText>
                        <ComplTSA>Yes</ComplTSA>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Sand, natural aggregate TL Gestein, grain size 0/2, supply, for embedment of pipelines DIN EN 1610, outside diameter up to 100 mm, install true to profile and compact, in trench, layer thickness over 15 to 20 cm, execution according to individual description, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          <TextComplement Kind="Owner" MarkLbl="11" ArtChrIdent="-484">
                            <ComplCaption><span>Individual description no. </span></ComplCaption>
                            <ComplBody><span> </span><br/><span>Sand bed, install in trench true to profile in 2 layers, for all depths.</span><br/><span>The line is to be sufficiently packed underneath.</span><br/><span>Work with hand tools and small equipment. </span><br/><span>Billing by volume measurement.</span><br/><span/><br/><span>Material: crushed sand 0/2 </span><br/><span>Support: 15 cm</span><br/><span>Cover: min. 20 cm </span><br/><span>Use: water pipeline </span></ComplBody>
                            <ComplTail><span/></ComplTail>
                          </TextComplement>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">.</span></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Sand embedment pipe AD up to 100mm install compact D 15-20cm</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
