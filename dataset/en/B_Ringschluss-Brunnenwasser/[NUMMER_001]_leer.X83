                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Root treatment for short-term excavation without root curtain in existing trench, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">trench depth 150 cm, recut roots, </span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">diameter over 2 cm to 4 cm, measured at the cut.</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Billing by number of roots cut back</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
