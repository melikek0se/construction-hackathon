                    <SumDescr>Yes</SumDescr>
                    <SubDescr>
                      <SubDNo>1</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Prefabricated branch, 90°-perpendicular DN 250/50</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">(273,0/400-60,3/125)</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Steel grade P235 GH</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">welded acc. to EN 10217</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">PEHD casing, incl. IPS</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">produced acc. to EN 448</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                          </DetailTxt>
                          <OutlineText>
                            <OutlTxt>
                              <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Prefabricated branch, 90°-perpendicular DN 250/50</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                            </OutlTxt>
                          </OutlineText>
                        </CompleteText>
                      </Description>
                      <UPBkdn>No</UPBkdn>
                    </SubDescr>
                    <SubDescr>
                      <SubDNo>2</SubDNo>
                      <Description>
                        <CompleteText>
                          <DetailTxt>
                            <Text><span style="text-align:left; font-size:10pt; font-family:Arial">ELE/ELÜ pipe DN 50 (60,3/125), [PERSON_129] 1A</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">L = 2,0 m, pressure rating PN 25</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Steel grade P235 GH, welded</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">PEHD casing, incl. IPS</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Broen [PERSON_115] 1.4404 red. bore SE/internal thread</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Blind plug, produced acc. to EN 488,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">adjustment of connecting pipeline in workshop and assembly planning</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
