                  <Item ID="I199" RNoPart="16">
                    <UPBkdn>No</UPBkdn>
                    <Qty>1</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><span style="text-align:left; font-size:10pt; font-family:Arial">Aeration and venting set for drinking water DN50, compact design, consisting of a shaft of stainless [PERSON_089] with integrated aeration and ventng valve (BEV) and shut-off, with lower flanged standpipe with drain fitting, exhaust air opening with insect screen, automatically operating, two-stage aeration and venting valve for filling and draining and for operational aeration and venting of pipelines, max. venting capacity 192 m3/h, venting cross-section 960 mm2 or 2 mm2, aeration and venting valve can be removed from the set for maintenance work, set can be shortened by 100 mm by others on site,</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Material:</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Shaft: stainless steel</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Base: GJS-400, corrosion protection by epoxy resin powder coating inside and outside in accordance with quality assurance RAL-GZ 662 of the quality association Heavy Corrosion Protection - GSK taking into account DIN 3476 (P) and DIN 30677-2 (coating thickness: min. 250 µm, freedom from pores at 3 kV, adhesion inside and outside min. 12 N/mm² after hot water storage, proof of suitability for drinking water, external monitoring by neutral test institute)</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Clamping bolt: stainless steel</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">BEV housing: POM</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Hood: PE</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Medium: well water</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Operating range: 0,1 - 6 bar</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Outlet: flange DN 50</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial">Pipe cover: 1,25 m</span><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-size:10pt; font-family:Arial"/><br/></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">Aeration and venting set for drinking water DN50, compact </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">design, consisting of a shaft of stainless </span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial">[PERSON_089]</span><span style="text-align:left; font-weight:bold; font-size:10pt; font-family:Arial"/><br/></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
