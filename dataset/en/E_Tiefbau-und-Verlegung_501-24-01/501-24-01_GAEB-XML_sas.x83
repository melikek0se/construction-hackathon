                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Diaphragm-controlled 3 - way air inlet and release valve</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">for drinking water PN 16 as follows:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Connection flange DN80</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">D-070-DN80-PN16</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Soft-closing diaphragm 3-way air inlet and release valve for drinking water </span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">and clear media of comparable density.</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">DVGW-Cert. (NW-6215 BS0200) incl. W270 + KTW</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">ÖVGW-Cert. (W 1.436), SVGW-Cert. ([TELEFON_078]) </span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Process connection: flange DN80, supply/exhaust air connection with 3" internal thread</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Pressure rating: PN 16 (working pressure: 0,2 - 16 bar)</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Large orifice: 5.153 mm², small orifice:  8 mm²</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Body material: ductile iron (GGG) with high-quality epoxy coating (EKB)</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Flushing adapter of [PERSON_115] for function check and flushing via the large</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">orifice cross-section, under operating pressure.</span>
                            </p>
                            <p style="text-align:justify;line-height:131%;">
                              <span style="background:#FFFFFF;">Sealing materials: EPDM + NBR</span>
                            </p>
