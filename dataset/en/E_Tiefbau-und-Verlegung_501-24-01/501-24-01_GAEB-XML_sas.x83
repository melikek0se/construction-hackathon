                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Surcharge to the item settling tank for relocating if required within the entire construction area on site.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Billing only for spatially separate places of use,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">a minor, constant relocating during the open dewatering forest area is to be included in the price of the dewatering!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surcharge to the item settling tank for relocating if required within the entire construction area on site.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008088" RNoPart="0012">
                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Infiltration swale dimensions according to [PERSON_125] of the AN, adapted to the local conditions</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">during topsoil stripping and lateral storage areas for [PERSON_093].</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The infiltration swales must be constructed and backfilled again, in terms of position, in the construction areas of the water pipeline route.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">If required, sedimentation or settling basins (as earth basins) </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">are to be pro vided there as well.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Surface discharge of the pumped-off groundwater into meadow areas</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">is not permitted!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Infiltration swale dimensions according to [PERSON_125] of the AN, adapted to the local conditions</span>
                              </p>
                            </TextOutlTxt>
