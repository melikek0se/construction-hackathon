                  <Item ID="GW_2008393" RNoPart="0006">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Annual software update lump sum for the data loggrs </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">AQUALINK3 IoT AQ Meter GSM 2-4G IP68, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">interface monitorring</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">AQ-SOFTWARE for digital, battery-operated line </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">and network zone monitoring for leakage monitoring, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">quality monitoring and provision of proof according to the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">TrinkwV 2023 (DIN 15975-2) of several parameters such as:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;"> - Pressure</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Temperature</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Flow</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Flow direction</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Volume</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Flow velocity</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Conductivity</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Turbidity</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - free chlorine</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Redox</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Water levels</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;"> - Leakage monitoring of creeping and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   very pipe bursts</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Temperature and stagnation monitoring</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Transmission and monitoring of</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   springs and spring collecting lines</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Data recording every 0,1 seconds up to </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    once per week</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Make: AQUALINK, or equivalent</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">service provider offered: ……………………………….</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
