                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Surcharge to pipe item GGG ZMU DN 300,</span>
                              <br/>
                              <span style="background:#FFFFFF;">produce socket joint for pipes with ZM - coating,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">execution and billing of additional expenses at all additional joints compared with the normal socket transitions, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(e.g. bends, built-in components, line shortenings),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">at which the ZMU - pipe has to be specially worked at the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ZM - coating for the connection, incl. cutting pipe.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Only spigot ends actually to be worked are billed.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
