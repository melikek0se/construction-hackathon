                  <Item ID="GW_2030478" RNoPart="0010">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Surcharge trench excavation main water pipeline for soil excavation and shoring for [PERSON_006] DN 2500 at approx. station 1+000 at the [PERSON_125] of the AN as follows:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Geology at RKS 10/25:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Forest soil/[PERSON_033] OK ground to - 0,10 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Weathered loam, [PERSON_033] from - 0,10 m to 1,20 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Moraine sand,fine sand      from - 1,20 m to 4,00 m final depth.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_029] initially not encountered during drilling, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_029] measured after end of drilling in the morain sands at - 1,40 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(no static water level).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Carry out preliminary excavation to approx. - 1,20 m below ground, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">dimensions approx. 4,0 x 4,0 m for placing shoring closed all round</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">at the [PERSON_125] of the AN.(Moraine sand must not flow in)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Remaining excavation approx. 1,80 m to excavation base approx. - 3,00 m below ground within the shoring,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sink shoring in the moraine sand down to the base,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Complete dewatering is to be carried out as well in the closed shoring approx. 1,0 l/s, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Geotextile RKl. 3 for filter-stable separation of gravel/crushed stone backfilling and in-situ soil in the base and rising all round to approx. - 0,50 m below OK grou</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">supply and place.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The entire shaft excavation approx. 50 - 60 cbm is hauled to the interim storage for sampling and stored there.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The shaft foundation with crushed stone, as well as refilling around the shaft struc-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ture is paid separately.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">All other required work such as excavation, placing and removing shoring again, dewatering and geotextile is to be included in the price here.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Billing is as a lump sum.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surcharge trench excavation main water pipeline for soil excavation and shoring for [PERSON_006] DN 2500 at approx. station 1+000 at the [PERSON_125] of the AN as follows:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
