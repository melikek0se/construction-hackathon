                  <Item ID="GW_2030639" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Breeches bend/ breeches tee piece DN 300 with saddle branch DN 80 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">flange connections PN 16 on all sides,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of 2 pieces pipe bend [PERSON_129] 3D 90°</span>
                              <span style="font-weight:bold;background:#FFFFFF;"> </span>
                              <span style="background:#FFFFFF;">(r =1,5xD) DN 300 </span>
