                  <Item ID="GW_2030602" RNoPart="0006">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Soil excavation sloped for new [PERSON_006] DN 1200</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">EZNZ Isnyberg 402 house connection shaft WWg 19 as follows:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Excavation sloped, in position offset approx. 1,50 m from the previously existing shaft</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">towards the centre of the road.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(Exposing, demolishing and removing the existing shaft is paid </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">separately).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Excavation depth up to approx. 2,0 m for complete shaf structure incl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">inlet and outlet lines, incl. intermediate formation level for PE pipes DA 63 and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DA 40-50 in total approx. 4-5 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. supply and place sand min. 10 cm all round PE - lines.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(PE - pipes are paid separately).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Reinstall and compact reusable [PERSON_093] from road sub-base, non-reusable material incl. shaft displacement</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">haul away and remove.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Any subsoil improvement and gravel backfilling with [PERSON_182] 0/X that may be required, as well as road reinstatement with frost protection gravel 0/45, are paid separately incl. hauling away of displaced material from gravel supply by proof of delivery notes and mass balance.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Soil excavation sloped for new [PERSON_006] DN 1200</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2013465" RNoPart="0007">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_006] DN 2500</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Shaft depth in the clear 1,70 m from UK cover slab to OK shaft floor,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">plus a further 0,40 - 0,45 m (cover slab and shaft floor) gives</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">a total shaft height of approx. 2,10 - 2,15 m.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Execution shaft base section incl. walls monolithic,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">cover slab separate (placing only after completion of the internal installation is to be included in the price),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN EN 1917, DIN 4034 - 1, [PERSON_129] 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">FBS quality or comparable,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Shaft structure in completely watertight execution as follows:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Base section with cellar gully and backwater valve DN 110,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Shaft walls h = 1,70 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 2 shaft penetrations for main line GGG DN 300 incl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  required annular seals, gas- and pressure-watertight!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Cover slab with opening DN 800 mm, eccentric, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Concrete collar b = 20 cm, h = 20 cm at the factory or on site at the [PERSON_125] of the AN,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   construct watertight on concrete top slab.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1 support ring DN 800 mm with shear lock,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- Manhole cover for water pipelines </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> clear width 800 mm </span>
                              <span style="background:#FFFFFF;">see separate item,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  </span>
                              <span style="font-weight:bold;background:#FFFFFF;">is paid separately. </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">incl. fixed points for fixing the water pipeline in the shaft,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">stainless steel supports and access ladder are paid separately.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">incl. complete buoyancy protection </span>
                              <span style="background:#FFFFFF;">against groundwater and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_149] present, at the [PERSON_125] of the AN produce on site or at the factory,</span>
                            </p>
                            <p>
