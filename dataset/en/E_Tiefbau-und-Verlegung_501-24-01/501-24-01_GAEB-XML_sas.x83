                  <Item ID="GW_2030728" RNoPart="0004">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_034]</span>
                              <span style="background:#FFFFFF;"> for pipe DA 355</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Construct and remove open excavation pit as [PERSON_034] for the horizontal bore, incl. keeping available on site the additional parts required for the bore,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">for pipe DA 355</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Dimensions acc. to [PERSON_125] AN.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Depth from GOK. Restoration of the ground surface is paid </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">separately.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Shoring, shoring penetration acc. to [PERSON_125] of the AN,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">To be included in the price: </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">install shoring according to structural requirements, keep available on site and remove, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">excavate, backfill and compact excavation pit base acc. to the ZTV and guidelines for excavations in traffic areas (ZTVA-StB), </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">load soil, transport within the site, store and </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">re-install, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">No shoring parts may remain in the soil.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Billing here is per piece for directional bore 2 forest track </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">station approx. 0+990.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The [PERSON_034] lies approx. at </span>
                              <span style="font-weight:bold;background:#FFFFFF;">RKS 10</span>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Dewatering open/ closed acc. to [PERSON_125] of the contractor with the aim of keeping the excavation pit base free of water, design water level for temporary works according to expert report. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">According to the expert report, for a water permeability coefficient of </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">kf = 1 x 10</span>
                              <span style="vertical-align:super;background:#FFFFFF;">-4 </span>
                              <span style="background:#FFFFFF;">m/s with a pit size of 3 x 3 m, the following water quantities to be pumped off</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">are estimated:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">at 1,60 m GW - lowering  =  3 - 5 l/s (with heavy precipitation </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">                                                    also up to approx. 10 l/s.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 6:       0,00 - 0,40 m   HB A 1 fill fine- coarse gravel </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,40  1,50 m    HB B 2 [PERSON_033], slightly weathered  ground moraine </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">                   1,50 - 3,00 m   HB B 5 ground moraine, [PERSON_033].</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">                                           </span>
                              <span style="font-weight:bold;background:#FFFFFF;">No [PERSON_029] down to - 3,0 m depth.</span>
                              <span style="background:#FFFFFF;">                   </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 7:       0,00 - 0,40 m   HB A 1 fill fine- coarse gravel </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,40  1,60 m    HB B 2 [PERSON_033], slightly weathered  ground moraine </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   1,60 - 2,00 m   HB B 5 ground moraine, [PERSON_033]. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                                            </span>
                              <span style="font-weight:bold;background:#FFFFFF;">No [PERSON_029] down to - 2,0 m depth.</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 8:       0,00 - 0,50 m   HB A 1 fill fine- coarse gravel </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,50  0,90 m    HB A 2 fill [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   0,90 - 1,40 m   HB B 1 peat</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                   1,40 - 4,00 m   HB B 3 moraine sand, fine sand.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                                           </span>
                              <span style="font-weight:bold;background:#FFFFFF;">(from -1,40 m [PERSON_029] in the moraine sands, slightly                                             confined)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">RKS 9:        0,00 - 0,40 m   HB A 1  fill fine- coarse gravel </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                    0,40 - 1,60 m  HB B 2  weathered loam, [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                    1,60 - 4,00 m  HB B 3  moraine sand, fine to medium sand.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                                           </span>
                              <span style="font-weight:bold;background:#FFFFFF;">(from -1,90 m [PERSON_029] in the                                                                                      moraine sands) </span>
                              <span style="background:#FFFFFF;">    </span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">RKS 10:</span>
                              <span style="background:#FFFFFF;">       0,00 - 0,10 m  forest soil, [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                     0,10 - 1,20 m  HB B 2  weathered loam, [PERSON_033]</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">                     1,20 - 4,00 m  HB B 3  moraine sand, fine sand. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                                                         </span>
                              <span style="font-weight:bold;background:#FFFFFF;">(from -1,40 m [PERSON_029] in the                                                                                      moraine sands) </span>
                              <span style="background:#FFFFFF;">                             </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Billing here is per piece for directional bore 2.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">[PERSON_034] for pipe DA 355</span>
