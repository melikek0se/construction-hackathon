                  <Item ID="GW_2008043" RNoPart="0048">
                    <Qty>100.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-size:11pt;background:#FFFFFF;">S</span>
                              <span style="background:#FFFFFF;">urcharge to all trench items of the water pipeline DN 300</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">for the complete civil works for laying an empty cable conduit alongside, described as follows:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Laying of a cable duct PE DN/OD 110 parallel to the water pipeline</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">DN 300 at the left or right trench edge  </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">approx. 20 - 30 cm above OK line DN 300 (approx. - 1,00 to 1,20 m below OK ground) including corresponding intermediate formation level.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Supply sand and surround pipe DN/OD 110 all round at least 10 cm thick,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">install material displaced by this in the construction area as well, or remove according to [PERSON_125] of the AN.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Cable duct is paid separately.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The laying must be done as planned on the intermediate formation level! </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">All required [ORT_030] for an additional cable pulling shafts</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">are to be included in the price here as well.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The spacing between the shaft structure water pipeline and cable shaft is approx. 100 m!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The cable protection system is to be constructed closed outside the shafts.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Corresponding welded or push-fit socket joints PE DN/OD 110 </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">are piad separately.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Execution from the water pipeline - shaft start of construction 0+000 to approx. 0+095 in the asphalt road for later power feed from Burg.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surcharge to all trench items of the water pipeline DN 300</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
