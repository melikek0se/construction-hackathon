                <Itemlist>
                  <Remark ID="GW_2008557">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Note on pricing for the following items with material [PERSON_115]:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">All pipes, fittings and connecting pieces and joints are, unless described otherwise, of stainless [PERSON_089] acc. to DVGW W541. Pipes and fittings are to be made of material 1.4571. Joints of different materials are to be galvanically separated.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">EPDM is to be used as material for the seal.</span>
                            </p>
                            <p style="text-align:justify;"/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                            </TextOutlTxt>
