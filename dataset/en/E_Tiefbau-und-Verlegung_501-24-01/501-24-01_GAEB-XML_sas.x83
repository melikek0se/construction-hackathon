            <BoQCtgy ID="GW_2007892" RNoPart="02">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">[ORT_030] roads, areas alongside roads, forest paths </span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2007893">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">For the execution the following apply:                              </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for [ORT_030] in road construction (ZTVE-StB),  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for the execution of base courses in </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">road construction (ZTVT-StB),                                 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for the execution of soil stabilisation </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">and soil improvement in road construction (ZTVV-StB),      </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the technical delivery conditions for mineral aggregates    </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in road construction (TL Min-StB).                            </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for excavations in traffic areas (ZTVA-StB).                     </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The leaflet for the backfilling of utility trenches.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Furthermore the following DIN standards with corresponding ATV`:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_030]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_019]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_008]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_031] outside buildings</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_010] (for topsoil works)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_018]</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">For the execution the following apply                              </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007894">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">The work is billed acc. to the respectively applicable</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN standards.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_030]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_019]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_008]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_031] outside buildings</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_010] (for topsoil works)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_018]</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">The work is billed acc. to the respectively applicable</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007895">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The determination of quantities for the billing of the work is done acc. to measurement and execution drawings.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">The determination of quantities for the billing of the work is done acc. to measurement and execution drawings.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007896">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">In the determination for soil excavation the following is deducted:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the volume of lines with an outer cross-section </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of more than 0,1 m²,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the volume of structures with a cubic content </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of more than 0,10 m³.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">In the determination for soil excavation the following is deducted</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007897">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Notes on all [ORT_030] in the area [PROJEKT_001]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">on the proper handling of cultivable soil material.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The basis for this is the soil protection concept prepared for this </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">project.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon Ah humus topsoil/ cultivable topsoil</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Proper handling strip and re-spread topsoil:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">If topsoil is temporarily stored in heaps, above-ground plant parts are to be removed as well as possible ahead of the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">topsoil stripping,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in order to be able to minimise harmful decomposition during temporary storage in heaps</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The topsoil stockpiles are to be laid out as loose fill, with a max. height</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of 2,00 m.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The stockpile is to be profiled in trapezoidal shape and must be smoothed, in order to avoid weather-related waterlogging.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">During temporary storage the biological activity of the topsoil is to </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">be preserved.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Necessary therefore are sufficient aeration, protection against waterlogging and, for topsoil material stored for longer, planting with labiates.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon Bv cultivable [PERSON_057] below the Ah horizon,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">to approx. - 0,80 m below ground OK</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Excavate [PERSON_057], store at the side and reinstall:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Material can and should be used for initial backfilling and re-backfilling under a sufficiently thick Ah - layer.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The cultivable [PERSON_057] (weathered loam/[PERSON_033])) is to be removed and reinstalled with care, excessive compaction and resulting </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">change of structure and waterlogging must be avoided.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The subsoil stockpiles are to be laid out with smoothed flanks of max. 3 m height.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon C I</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">From a depth of - 0,80 m below ground OK aeolian-shaped </span>
                              <span style="font-weight:bold;background:#FFFFFF;">"cover layers"</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Slightly to weakly clayey, sandy, as well as weakly gravelly silts.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon C II </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Deeper subsoil cover loams and moraine sediments </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">moraine sand, moraine gravel and ground moraine.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">General requirements for the handling of all horizons:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The individual horizons should if possible be reinstalled in their original order, i.e. A over B over C.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Mixing of the material of the individual horizons is to be avoided.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Displaced, surplus excavation must be placed in heaps on a storage area </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">, sampled acc. to EBV/VwV Baden Württemberg and then taken to a suitable recycling facility.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Corresponding items are provided for this in the tender.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Minimising of driving over areas and maximum reduction of transport distances, use of tracked excavators with long-reach buckets; </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">no bulldozers, use of tractors with favourable tyre pressure on sensitive ground.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">No driving on the surrounding open areas = no-go areas (e.g. agricultural areas); unavoidable crossing only with vehicles of low ground pressure (tracked vehicles, tractors with dump trailer, wheeled vehicles only in combination with suitable mats).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">In the area of the pipeline route in public paths with execution </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">vertical in shoring, the AN has to price for work sequences in the </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">overhead method, both for the path construction and for the civil works water pipeline.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">A corresponding additional deployment of machines and personnel must be taken into account here without fail!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The total length of the affected path and laying sections in the shored trench is approx. 90 - 100 m, of which approx. 80 m in the forest path area from</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">approx. station 0+990 - to 1+070 end of construction.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The execution of the work in general, is to be carried out after prior coordination with the respective property owners, or tenants of the affected properties also with regard to necessary meadow cuts and forestry work!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">This applies to cut and fill areas!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The estimator is urgently recommended to inspect the corresponding,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">available soil protection concept!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note: In the trade civil works water pipeline a difficulty item                     for all additional expenditure, for all trades with regard to the                  soil protection concept to be complied with is tendered.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                </span>
                              <span style="font-weight:bold;background:#FFFFFF;">There the estimator has to include in the price the entire additional expenditure of the </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">                overall project!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Notes on all [ORT_030] in the area [PROJEKT_001]</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007898">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note</span>
                              <span style="background:#FFFFFF;"> on the removal and further recycling/landfilling of</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">temporarily stored, sampled [PERSON_093] road and path construction:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Billing is done via the corresponding items in the trade civil works water pipeline!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Here in the trade road and path construction only the work excavation and removal to the interim storage area for sampling is tendered.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The estimator has to observe this!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Note on the removal and further recycling/landfilling of</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2019551">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Note on all [ORT_030]:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The civil works are essentially tendered acc. to the new DIN 18300 (2015-08)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[ORT_030] on the basis of DIN 4020 geotechnical investigations for construction purposes with the corresponding homogeneous zones </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The basis is the geotechnical report by fm - Geotechnik</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">engineering office for geotechnics.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The homogeneous zones listed here are described in detail in the relevant </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">excavation items with their respective, estimated proportional quantities</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB A1: fills gravel</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   3, 4, </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB A2: fill [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 1: peat</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   2/4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 2:  weathered loam/slightly weathered ground moraine</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 3:  moraine sand</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   2,3,4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 4:  moraine gravel</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   3,4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 5:  ground moraine, [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   4</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">As the cohesive soils encountered are partly sensitive to water, these soils can soften with improper temporary storage and with heavy precipitation during a transport or through mechanical stress, so that they may pass into soil class 2 acc. to DIN 18300 (2012-09) or into a pulpy consistency.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The AN</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">has to ensure</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">that these sensitive soils do not</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">pass into soil class 2.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">A payment for soil class 2 does not take place!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Note on all [ORT_030]:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2019756">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Overview of the homogeneous zones in road and path construction with an excavation depth up to approx, 0,80 m from OK ground:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogeneous zone 1</span>
                              <span style="background:#FFFFFF;">, with 3 soil groups, soil group 1 GU DIN 18196 (gravel-[PERSON_033]-mixture), soil group 2 GU* DIN 18196 (gravel-[PERSON_033]-mixture), soil group 3 UL DIN 18196 (slightly plastic [PERSON_033]), depth of upper horizon of the homogeneous zone from 0 m, depth of lower horizon of the homogeneous zone to 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">estimated share of the homogeneous zone in the total excavation quantity 90,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">local designation homogeneous zone A 1 fill,gravel soil cl. 3,4, acc. to DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Construction project of geotechnical category 2 DIN 4020, grain size distribution range DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] lower value 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] upper value 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] lower value 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] upper value 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand lower value 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand upper value 40 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel lower value 50 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel upper value 70 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) lower value 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) upper value 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- bulk density of soil DIN EN ISO 17892-2 or DIN 18125-2 over 2000 to 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- water content up to 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- density of packing medium dense,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- organic mass fraction DIN 18128 greater than 5 %,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogeneous zone 2</span>
                              <span style="background:#FFFFFF;">, with 2 soil groups, soil group 1 UL DIN 18196 (slightly plastic [PERSON_033]), soil group 2 UM DIN 18196 (medium plastic [PERSON_033]), depth of upper horizon of the homogeneous zone from 0 m, depth of lower horizon of the homogeneous zone to 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">estimated share of the homogeneous zone in the total excavation quantity 10,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">local designation homogeneous zone A 2 fill, [PERSON_033] soil cl. 4, acc. to DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Construction project of geotechnical category 2 DIN 4020, grain size distribution range DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] lower value 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] upper value 20 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] lower value 55 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] upper value 75 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand lower value 10 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand upper value 30 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel lower value 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel upper value 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) lower value 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) upper value 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- bulk density of soil DIN EN ISO 17892-2 or DIN 18125-2 over 2000 to 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- shear strength undrained from 20 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- shear strength undrained to 40 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- water content up to 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- consistency index DIN EN ISO 17892-12 Ic from 0,5,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- consistency index DIN EN ISO 17892-12 Ic to 0,75,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- plasticity index DIN EN ISO 17892-12 Ip from 4 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- plasticity index DIN EN ISO 17892-12 Ip to 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- organic mass fraction DIN 18128 greater than 5 %.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Overview of the homogeneous zones in road and path construction with an excavation depth up to approx, 0,80 m from OK ground:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2007899" RNoPart="0001">
                    <Qty>100.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Soil for traffic areas, from ground surface,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">after removal of surface pavements (asphalt), if present,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">or from OK gravel and forest paths,</span>
                              <br/>
                              <span style="background:#FFFFFF;">loosen true to profile and load directly, work with equipment, load onto truck of the AN, transport and drive to interim storage of the AN up to approx. 5 KM one-way  distance for sampling and unload.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Area traffic areas (accesses local paths/roads with asphalt pavement) and unpaved forest and connecting paths (gravel paths).</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Execution and billing only outside the water pipeline trench!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Inside the water pipeline trench the billing of excavation is done in the trade civil works water pipeline up to OK ground.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The re-loading and further recycling/disposal according to analysis result is paid separately in the trade civil works water pipeline in corresponding items </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">.  </span>
                              <br/>
                              <span style="background:#FFFFFF;">Excavation depth up to 0,80 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">execution incl. producing the subgrade to receive the gravel layer,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">road and path construction.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Determination of quantities acc. to measurement and excavation profiles.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Note:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Should, in the course of the construction project, excavation quantities be driven not to the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">interim storage, but directly from the excavation point to further recycling locations as specified by the municipality or farmers, these quantities are to be documented for billing for the overall mass balance </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">acc. to haulage reports.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Billing is likewise done here in this item!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Before execution the site management of the AG is to be informed!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Homogeneous zones concerned below:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogeneous zone 1</span>
                              <span style="background:#FFFFFF;">, with 3 soil groups, soil group 1 GU DIN 18196 (gravel-[PERSON_033]-mixture), soil group 2 GU* DIN 18196 (gravel-[PERSON_033]-mixture), soil group 3 UL DIN 18196 (slightly plastic [PERSON_033]), depth of upper horizon of the homogeneous zone from 0 m, depth of lower horizon of the homogeneous zone to 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">estimated share of the homogeneous zone in the total excavation quantity 90,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">local designation homogeneous zone A 1 fill,gravel soil cl. 3,4, acc. to DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Construction project of geotechnical category 2 DIN 4020, grain size distribution range DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] lower value 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] upper value 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] lower value 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] upper value 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand lower value 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand upper value 40 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel lower value 50 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel upper value 70 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) lower value 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) upper value 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- bulk density of soil DIN EN ISO 17892-2 or DIN 18125-2 over 2000 to 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- water content up to 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- density of packing medium dense,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- organic mass fraction DIN 18128 greater than 5 %,</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Homogeneous zone 2</span>
                              <span style="background:#FFFFFF;">, with 2 soil groups, soil group 1 UL DIN 18196 (slightly plastic [PERSON_033]), soil group 2 UM DIN 18196 (medium plastic [PERSON_033]), depth of upper horizon of the homogeneous zone from 0 m, depth of lower horizon of the homogeneous zone to 1 m,</span>
                              <br/>
                              <span style="background:#FFFFFF;">estimated share of the homogeneous zone in the total excavation quantity 10,000 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">local designation homogeneous zone A 2 fill, [PERSON_033] soil cl. 4, acc. to DIN 18300 (2012-09).</span>
                              <br/>
                              <span style="background:#FFFFFF;">Construction project of geotechnical category 2 DIN 4020, grain size distribution range DIN EN ISO 17892-4:</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] lower value 2 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_108] upper value 20 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] lower value 55 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- [PERSON_033] upper value 75 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand lower value 10 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions sand upper value 30 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel lower value 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fractions gravel upper value 15 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) lower value 0 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- mass fraction cobbles DIN EN ISO 14688-1 (Co) upper value 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- bulk density of soil DIN EN ISO 17892-2 or DIN 18125-2 over 2000 to 2200 kg/m3,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- shear strength undrained from 20 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- shear strength undrained to 40 kPa,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- water content up to 5 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- consistency index DIN EN ISO 17892-12 Ic from 0,5,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- consistency index DIN EN ISO 17892-12 Ic to 0,75,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- plasticity index DIN EN ISO 17892-12 Ip from 4 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- plasticity index DIN EN ISO 17892-12 Ip to 25 %,</span>
                              <br/>
                              <span style="background:#FFFFFF;">- organic mass fraction DIN 18128 greater than 5 %.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Soil traffic area loosen with equipment load transp. truck AN dispose pay.dispos. AN AVV170504 excav.-T 1m GW GI GU GT GU*</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007900" RNoPart="0002">
                    <Qty>85.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Work as item last described in full wording,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">but </span>
                              <span style="font-weight:bold;background:#FFFFFF;">recyclable [PERSON_112]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for traffic areas loosen true to profile, within the overall project </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. any  required interim storage at [PERSON_125] of the AN, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">haul </span>
                              <span style="font-weight:bold;background:#FFFFFF;">and reinstall and compact as remaining trench backfilling or substrate improvement in trenches.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Excavation depth approx. 0,25 to 0,30 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">determination of quantities acc. to excavation profiles.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution including producing subgrade.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Area traffic areas (accesses local paths/roads, yard accesses,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">adjustments) and unpaved forest and connecting paths </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution and billing only after express consultation with the site management! </span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Work as item last described in full wording,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007902" RNoPart="0003">
                    <Qty>550.000</Qty>
                    <QU>m2</QU>
                    <Description>
