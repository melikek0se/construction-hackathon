                  <Item ID="GW_2013463" RNoPart="0004">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Soakaway shaft for drainage line from water pipeline shafts </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">round DN 1000</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Shaft complete without manhole cover</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">supply and install</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Shaft depth up to approx. 1,60 m OK cone 625/1000, to UK shaft rings</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN EN 1917, DIN 4034 - 1, [PERSON_129] 2,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">FBS quality or comparable,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">including:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Shaft penetration for PE DA 110 is made on site and paid </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  separately.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Place shaft rings H = approx. 1,00 m without floor on concrete foundation,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Construct concrete foundation 30 x 45 with concrete C 20/25 all round under shaft rings </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  complete, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Partial backfilling shaft DN 1000, h = approx .50 - 60 cm with drainage gravel 16/32 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  to be supplied.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Shaft cone DN 1000 with opening DN 625 mm, eccentric, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  2 support rings DN 625 mm with shear lock,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Step rungs [PERSON_115] approx. 6 pieces.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Manhole cover for water pipelines </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> clear width 625 mm </span>
                              <span style="background:#FFFFFF;">see separate item,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  </span>
                              <span style="font-weight:bold;background:#FFFFFF;">is paid separately.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Additional effort excavation shaft at the side in the area of sloped trench 45° main water pipeline is likewise to be included in the price here!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Execution see also drawing!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Soakaway shaft at approx. station 0+100 asphalt path.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Soakaway shaft for drainage line from water pipeline shafts </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
