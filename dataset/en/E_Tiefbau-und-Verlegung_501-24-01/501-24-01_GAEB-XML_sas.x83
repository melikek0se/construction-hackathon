                  <Item ID="GW_2007990" RNoPart="0018">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Surcharge to the earth movement the items soil excavation with re-backfilling</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">of the water pipeline GGG DN 300 ZMU, trench walls vertically shored and </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">sloped, for:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Sorting out and removal of backfill material (in-situ or supplied) with a grain size </span>
                              <span style="font-weight:bold;background:#FFFFFF;">&gt; 100 mm.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The permissible grain size of the pipe surround materials acc. to DVGW . worksheet W 400-2 for pipes with cement mortar - coating is </span>
                              <span style="font-weight:bold;background:#FFFFFF;">max. 100 mm.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Likewise the pre-sorting, required under certain circumstances, of the </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">[PERSON_093] to be installed directly in the pipe zone (well compactable) is to be included in the price as well.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The execution includes both manual and machine work.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The estimator has to include both in connection with the present</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">geotechnical report (homogeneous zones with share of cobbles).</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Total length open-cut construction shored and sloped approx. 675 m.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Billing lump sum for the overall project.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surcharge to the earth movement the items soil excavation with re-backfilling</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
