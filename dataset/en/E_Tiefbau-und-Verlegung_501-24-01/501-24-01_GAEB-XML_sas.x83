                  <Item ID="GW_2008596" RNoPart="0001">
                    <Qty>405.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Pressure pipe PE100RC TW AD/WD 355/32,2 mm PAS 1075 [PERSON_129] 3</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Pressure pipe of PE 100 with outer protective jacket DIN 8074 and DIN 8075,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">with highest resistance to slow crack growth,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">a core pipe of PE 100 - RC and</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">a bi - axially oriented polymer - matrix - film with embedded </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">metallic diffussion barrier as permeation barrier and a </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">protective jacket of modified polyolefin compound. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Pipe colour [PERSON_031],</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">protective jacket colour signal blue,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">suitable for drinking water, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">pipe with DVGW type-examination mark,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">material grade certified by recognised testing, certification and monitoring body according to PAS 1075,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">outside diameter 355 mm, wall thickness 32,2 mm, SDR 11 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in straight lengths, with plain ends, lengths of 12 m, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">laying DVGW GW 321, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for laying by means of trenchless laying method (directional drilling/pipe bursting),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. producing assembly area and roller track,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">directional bore is paid separately, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">pipes with  removal and restoration of the protective jacket, as well as of the diffussion barrier, butt-weldable, the welding must be carried out according to the parameters of DVS 2207 - 1 observing the joining pressures specified for PE.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Joint is paid separately.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Manufacturer/[PERSON_129]: GEROfit REX drinking water pressure pipe</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                         [FIRMA_029] </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                         Phone [TELEFON_012]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                         [URL_004]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">or a product of equivalent kind...................................................................</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The product is to be entered by the AN. </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Billing is by the actually welded, required total length of the line.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Execution in the area of both directional bores 1 and 2.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note:</span>
                              <span style="background:#FFFFFF;"> PE - pipes DA 355 at the transitions directional bores and change of material to GGG DN 300 ZMU pipes are, in the trade supply and lay</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">water pipeline in the area of open-cut construction, paid separately!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Pressure pipe PE100RC drinking water AD/WD 355/32,2 mm PAS 1075 [PERSON_129] 3</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008598" RNoPart="0002">
                    <Qty>35.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Welded joint heated-tool - butt welding PE AD/WD 355/32,2 mm</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Welded joint as heated-tool - butt welding, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">on individual pipes, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">on [ORT_031] for drinking water, of PE DIN 8074 and DIN 8075, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">PE 100, outside diameter 355 mm, wall thickness 32,2 mm,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">with a bi - axially oriented polymer - matrix - film with embedded </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">metallic diffussion barrier as permeation barrier and a protective jacket of modified polyolefin compound. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Produce according to the requirements of the valid technical guidelines of the DVS ( DVS 2207 [ORT_016] 1 )</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the pipe joints are to be executed according to the manufacturer's current technical laying instructions,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">welding with CNC control and digital documentation of every welded joint,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The documentation is to be submitted unrequested for commissioning of the line.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">In addition to the removal and restoration of the protective jacket with </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">diffussion barrier according to manufacturer's specifications, for every welded joint, as outer closure and protection of the joint in the course of the directional bore, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">a suitable shrink socket incl. material is to be produced.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Execution in the area of both directional bores 1 and 2. </span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Welded joint heated-tool - butt welding PE AD/WD 355/32,2 mm</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
