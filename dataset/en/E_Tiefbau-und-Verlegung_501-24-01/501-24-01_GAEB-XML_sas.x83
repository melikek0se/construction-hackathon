                      </STLBBau>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Pipe cut and bevelling DIN EN ISO 9692-1 inside pipe trenches, on individual pipes, on [ORT_031] for drinking water, of PE DIN 8074 and DIN 8075, PE 100, DN/OD 355, SDR 11.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Pipe cut bevelling PE DN/OD355</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008496">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">[PERSON_076]</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">[PERSON_076]</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2008497">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note</span>
                              <span style="background:#FFFFFF;"> for the supply and laying of the GGG pipes DN 300 ZMU with </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">regard to the execution of the trench and of the socket joints:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The following item are to be priced for laying in shored and sloped trenches!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The share of shored trench is   approx.   95 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the share of sloped trench is approx.  580 m.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">In the base item the ductile [PERSON_076] DN 300 ZMU incl.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">socket joint with seal [PERSON_129] TYTON/STD are tendered.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The GGG pipes DN 300 ZMU are additionally laid completely with restrained </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">joints [PERSON_129] Standard Vi or SIT seal with </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">marking ring.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A surcharge item is tendered for this.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The estimator has to take this into account.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Note for the supply and laying of the GGG pipes DN 300 ZMU with </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
