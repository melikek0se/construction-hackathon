        <BoQCtgy ID="GW_2008479" RNoPart="03">
          <LblTx>
            <p>
              <span style="background:#FFFFFF;">SUPPLY AND LAY THE WATER PIPELINE OPEN-CUT CONSTRUCTION</span>
            </p>
          </LblTx>
          <NotApplBoQ>No</NotApplBoQ>
          <BoQBody>
            <Remark ID="GW_2008480">
              <Description>
                <CompleteText>
                  <DetailTxt>
                    <Text>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">For the tendered work the client requires  a proof of qualification.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">For this the pipeline company must furnish the proof of professional suitability by:</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;font-size:11pt;background:#FFFFFF;">1. The DVGW - certification, or</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;font-size:11pt;background:#FFFFFF;">2. that, work carried out by it in the last three completed financial years is comparable with the work awarded.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;font-size:11pt;background:#FFFFFF;">For this, references from the respective clients are to be submitted with the bid!</span>
                      </p>
                      <p style="text-align:justify;"/>
                    </Text>
                  </DetailTxt>
                  <OutlineText>
                    <OutlTxt>
                      <TextOutlTxt>
                        <p/>
                      </TextOutlTxt>
                    </OutlTxt>
                  </OutlineText>
                </CompleteText>
              </Description>
            </Remark>
            <Remark ID="GW_2008481">
              <Description>
                <CompleteText>
                  <ComplTSB>Yes</ComplTSB>
                  <DetailTxt>
                    <Text>
                      <p>
                        <span style="font-weight:bold;background:#FFFFFF;">Note on the cost estimate "Manufacturer/[PERSON_129] XXXX / XXXX or equivalent":</span>
                      </p>
                      <p>
                        <span style="background:#FFFFFF;">If, where a product is specified, the bidder enters</span>
                      </p>
                      <p/>
                      <p>
                        <span style="background:#FFFFFF;">Manufacturer/[PERSON_129] XXXX / XXXX</span>
                      </p>
                      <p>
                        <span style="background:#FFFFFF;">or equivalent</span>
                      </p>
                    </Text>
                    <TextComplement Kind="Bidder" MarkLbl="60" Empty="Yes" ArtChrIdent="-25">
                      <ComplCaption>
                        <span style="background:#FFFFFF;">Manufacturer/[PERSON_129] </span>
                      </ComplCaption>
                      <ComplBody>
                        <span style="background:#FFFFFF;">'....................................................'</span>
                      </ComplBody>
                      <ComplTail>
                        <br/>
                        <span style="background:#FFFFFF;">to be entered by the bidder.</span>
                      </ComplTail>
                    </TextComplement>
                    <Text>
                      <p/>
                      <p>
                        <span style="background:#FFFFFF;">no product to be supplied by it, the client's product specification becomes binding.</span>
                      </p>
                      <p/>
                    </Text>
                  </DetailTxt>
                  <OutlineText>
                    <OutlTxt>
                      <TextOutlTxt>
                        <p>
                          <span style="background:#FFFFFF;">Note on the cost estimate "Manufacturer/[PERSON_129] XXXX / XXXX or equivalent":</span>
                        </p>
                      </TextOutlTxt>
                    </OutlTxt>
                  </OutlineText>
                </CompleteText>
              </Description>
            </Remark>
            <Remark ID="GW_2008482">
              <Description>
                <CompleteText>
                  <DetailTxt>
                    <Text>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Notes on the pipeline and billing:</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Factory-applied pipe protection                                </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">for pressure pipes, fittings and connecting pieces            </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">of ductile cast iron,                                 </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">External protection</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">factory-applied fibre cement mortar coating,  cement mortar lining</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">for the main pipe DN 300,                                            </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">DIN 30674-3 zinc coating with finishing layer for transition pieces and </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">fittings      </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Internal protection                                            </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">factory-applied cement mortar lining DIN 2614.</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">For all following valves, fittings and connecting pieces, the flat gaskets and bolts for flange joints, and the associated sealing rings for cast iron, PVC or PE- pipes for socket joints, are to be included in the unit prices as well. </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">The valves, fittings and pipes are to be offered as supply, unload and lay  fully assembled.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="background:#FFFFFF;">Restraints at socket joints are, if not described in the base item, paid separately as a surcharge.</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">All fittings and connecting pieces are to be priced as a surcharge to the </span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">base item pressure pipeline.</span>
                      </p>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">In billing these fittings and connecting pieces are measured through!</span>
                      </p>
                      <p style="text-align:justify;"/>
                      <p style="text-align:justify;">
                        <span style="font-weight:bold;background:#FFFFFF;">Pipe cuts on the new pipeline on pipe pieces without socket before / after bends, or crossing and handover points, are to be included in the price of the respective fittings and connecting pieces required for them!</span>
                      </p>
                      <p style="text-align:justify;"/>
                    </Text>
                  </DetailTxt>
                  <OutlineText>
                    <OutlTxt>
                      <TextOutlTxt>
                        <p>
                          <span style="background:#FFFFFF;">Notes on the pipeline and billing:</span>
                        </p>
                      </TextOutlTxt>
                    </OutlTxt>
                  </OutlineText>
                </CompleteText>
              </Description>
            </Remark>
            <BoQCtgy ID="GW_2008483" RNoPart="01">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Site setup supply and lay the water pipeline</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Item ID="GW_2008484" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1310110721</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Bring to the site, provide and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- insofar as the use of equipment is not paid</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">separately - set up ready for operation the equipment,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">tools and other operating resources that are required</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for the execution of the construction work in accordance with the contract, incl. the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">work necessary for this. Construct the required fixed installations.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Site offices, accommodation, workshops, storage</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sheds and the like, insofar as required, transport to site,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">erect and fit out. Power, [PERSON_029], tele-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">phone connection as well as disposal facilities and the like</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for the site, insofar as required, construct. If</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">needed, lay out storage areas, other hardstandings and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">paths in the site area. Carry out topsoil works</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. removal of vegetation for the site set-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">up, insofar as required. Pro-</span>
                            </p>
