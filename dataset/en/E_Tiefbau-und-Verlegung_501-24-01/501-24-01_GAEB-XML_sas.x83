                <Itemlist>
                  <Item ID="GW_2008390" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Assembly works of the measuring sensor </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">AQUALINK, or equivalent</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">onto the existing drinking water line, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in the building and or shaft structure</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">installation of the AQUALINK- measuring probe for </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">flow, flow direction, pressure and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">temperature incl. commissioning, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">setting and adjustment, instruction and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">acceptance with the operator's personnel on site</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">with recording in a protocol.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Incl. acceptance protocol and operating manual,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">travel to and from site of the specialist personnel by the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">manufacturer.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Assembly works of the measuring sensor </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008391" RNoPart="0002">
                    <Qty>2.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Multi-sensor system for the measurement of several parameters in </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">drinking water lines by means of </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">flow sensor with integrated pressure and temperature</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sensors, from DN 80 to DN 600 PN 16</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in [PERSON_115] design for the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">connection thread DN 40 11/2 inch</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for installation in buildings and shaft structures,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for permanent measurement of pressure, temperature, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">flow and flow direction</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Make: </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ARMARE-TEC AQUALINK, [PERSON_129] AQ VA PTFLOW</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">or equivalent</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">make offered: ……………………………….</span>
                            </p>
                            <p/>
                            <p style="margin-bottom:8pt;line-height:108%;">
                              <span style="background:#FFFFFF;">supply incl. sealing and connecting material,</span>
                            </p>
                            <p style="margin-bottom:8pt;line-height:108%;">
                              <span style="background:#FFFFFF;">and assemble professionally according to manufacturer's instructions,</span>
                            </p>
                            <p style="margin-bottom:8pt;line-height:108%;">
                              <span style="background:#FFFFFF;">adjust and put into operation.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Multi-sensor system for the measurement of several parameters in </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008392" RNoPart="0003">
                    <Qty>1.000</Qty>
                    <QU>Stk</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Data logger for data transmission of the measured values</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of pressure, temperature, flow and flow direction</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. cable, plug, battery and antenna. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">with the following configuration:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Inputs:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 3 inputs configurable (2x digital counter, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    voltage 0-3V / 4-20mA + 1x voltage 0-3V </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    / 4-20mA) with programmable</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    output power for each input</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 1-Wire (compatible with 1–Wire </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    temperature sensors)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Reserved input for AQPressure – </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   low-voltage sensor with 0-30 bar </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   pressure measurement (+- 50 mbar accuracy at 0-6  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   bar) and temperature sensor (-20 to +85°C)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Rs485</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Optional M -Bus</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Outputs:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- 1x relay output with programmable 6-24V </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  voltage output, reverse polarity protection and up to </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  10W pulse. Can be connected directly to pulse-controlled</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  solenoid coil.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Input types (individually configurable with software):</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Digital (measures pulses from HRI, REED, Cyble, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   short circuit) - counter mode</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Analogue (measures voltage 0-3 V)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 0/4-20mA current loop (2- and 4 Wire support)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">For each input a separate current loop can be </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">configured which then supplies the connected sensors </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">with power from the internal batteries. The supply</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">voltage and supply time is separately configurable for each</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> input (from 6V to 30V).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Communication:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Built-in GSM modem (GSM/GPRS/EDGE </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   900/1800, LTE-FDD B1/B3/B7/B8/B20, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   UMTS/HSPA +B1/B8)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - GPRS/3G/4G and SMS communication with </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   AQWeb Server (configurable)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Optional GPS</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Accepts SIM cards in normal size</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   Bluetooth for programming on site (v4.2  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   BR/EDR)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Wi-Fi (802.11 b/g/n)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Local connection with USB cable </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   (configuration and fault diagnosis)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Features:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Housing: IP68, DIN rail option</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Dimensions(mm): 160 x 80 mm</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Weight: 800g</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Assembly:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 3 holes in the housing for cable ties and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   wall brackets</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Operating environment:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Temperature range: reduced service life  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">    of the battery outside -15°C and +55°C</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Air humidity: 0-100% non-condensing</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Power supply:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Standard 2x 3,6V Li-SOCI2 battery, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   optionally 3 pieces</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Standard battery life up to 6 years (depending </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   on configuration)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Batteries easily replaceable</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Optional mains power supply, solar panel or </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   rechargeable batteries</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Firmware functions configuration:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 2-way communication with Bluetooth or Wi-Fi</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - 2-way communication with AquaWeb Server</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - automatic firmware update via the  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   internet or USB cable</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - all parameters can be configured via the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   internet</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Data sent during communication:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - AQUALINK AQ ID</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - SIM number</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Approximate location via GSM triangulation</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Date and time</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Data logger measured values</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Battery level</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - GSM signal</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Firmware version</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Own power consumption</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Configurable parameters:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Date and time</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Intervals of recording and transmission </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   of data</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Mode for each input</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Cumulative for the digital input mode</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Alarm limit values (max. number of pulses </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   between configured intervals before the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   alarm is triggered, max. and min. value for</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - voltage and current loop before the alarm </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   is triggered)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Mobile provider APN settings for the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   GPRS/3G/4G connection</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Data transmission (GPRS/3G/4G and SMS):</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Minimum transmission interval of the data is 1 minute </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   (GPRS/3G/4G/SMS) up to once per month</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Data acquisition:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Data recording every 0,1 seconds up to </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   once per week</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Internal data memory for 300.000 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   storage intervals</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Alarms:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Independently configurable threshold values for   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   each input (max. number of pulses </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   during a storage interval for</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  digital mode, min. and max. value for analogue </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  or 4-20mA mode)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;"> - If the defined threshold values are </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   exceeded, an alarm with the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   current input value and the type of alarm is</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">   sent (lower limit, upper limit).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Optional:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Mast with additional antenna</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Additional inputs</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - SIM chip</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Installation tools</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - Various sensors (pressure, fill level, pH,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;"> - temperature, air humidity etc.)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Make: </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">ARMARE-TEC AQUALINK, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129] AQUALINK3 IoT AQ Meter GSM 2-4G IP68 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">with connector plug and antenna, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">or equivalent.</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">make offered: ……………………………</span>
                            </p>
                            <p/>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">supply, assemble and put into operation professionally.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Data logger for data transmission of the measured values</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
