                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Surcharge to pipe item GGG ZMU DN 300 for</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">supply and install a matching</span>
                              <br/>
                              <span style="background:#FFFFFF;">protective sleeve for pipes with ZM - coating,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for Tyton- as well as restrained and form-locked joints.</span>
                              <br/>
                              <span style="background:#FFFFFF;">Material: TPE or EPDM, L = 190 - 200 mm.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution at all ZM - joints.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
