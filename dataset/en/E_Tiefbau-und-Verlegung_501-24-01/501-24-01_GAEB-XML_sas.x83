                              <span style="background:#FFFFFF;">'430'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;"> m, [PERSON_029] is provided and is to be discharged. Execution according to individual description,</span>
                            </ComplTail>
                          </TextComplement>
                          <Text>
                            <br/>
                          </Text>
                          <TextComplement Kind="Owner" MarkLbl="12" ArtChrIdent="-484">
                            <ComplCaption>
                              <span style="background:#FFFFFF;">Individual description no. </span>
                            </ComplCaption>
                            <ComplBody>
                              <span style="background:#FFFFFF;">'Execution in 1-2 sections in the area of the  2 direcctional bores. </span>
                              <br/>
                              <span style="background:#FFFFFF;">Type of execution PE pipes with contraction test!'</span>
                            </ComplBody>
                            <ComplTail>
                              <span style="background:#FFFFFF;">.</span>
                            </ComplTail>
