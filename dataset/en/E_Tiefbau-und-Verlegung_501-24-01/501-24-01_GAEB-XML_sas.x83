                  <Remark ID="GW_2008488">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">PE - PIPES OPEN-CUT CONSTRUCTION</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Execution only in small quantities/short lengths at the respective transitions to the directional drillings and/or change of material. </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The PE - pipes for the directional drillings are paid separately!</span>
