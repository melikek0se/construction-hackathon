                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007956" RNoPart="0015">
                    <Qty>2.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Work as previous item,</span>
                              <br/>
                              <span style="background:#FFFFFF;">but dynamic plate load test with EvD - value</span>
                              <br/>
                              <span style="background:#FFFFFF;">in correlation with the static EV 2 values,</span>
                              <br/>
                              <span style="background:#FFFFFF;">EV 2 =&gt; 120 MN/m²  =  EVD =&gt; 65 MN/m² (ZTV- SoB),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">on subgrade EV 2 =&gt; 45 MN/m2 = EVD  =&gt; 25 MN/m².</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Work as previous item,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy ID="GW_2007957" RNoPart="02">
          <LblTx>
            <p>
              <span style="background:#FFFFFF;">CIVIL WORKS WATER PIPELINE WITH STRUCTURES IN OPEN-CUT CONSTRUCTION</span>
            </p>
            <p>
              <span style="background:#FFFFFF;">TRENCHES AND EXCAVATION PITS</span>
            </p>
          </LblTx>
          <NotApplBoQ>No</NotApplBoQ>
          <BoQBody>
            <BoQCtgy ID="GW_2007958" RNoPart="01">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Site setup civil works [PROJEKT_001]</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Item ID="GW_2007959" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1010110721</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Bring to the site and provide equipment, tools and other</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">operating resources that are required for the execution of the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">construction work in accordance with the contract, and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- as far as the use of equipment is not paid separately</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- set up ready for operation incl. the work</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">necessary for this. Construct the required fixed</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">installations. Site offices, accommodation, workshops, storage</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">sheds and the like, as far as required, transport to</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">site, erect and furnish. Power, [PERSON_029], tele-</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">phone connection as well as disposal facilities and the like</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">for the site, as far as required, construct. If</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">needed lay out storage areas, other hardstandings and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">paths in the site area. Carry out topsoil works</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. removal of vegetation for the site</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">setup, as far as required. Procure</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">areas, if those made available by the AG</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">are not sufficient. Costs for keeping available, maintaining and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">operating the equipment, installations and facilities</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">incl. rents, lease, fees and the like are not</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">paid with this lump sum, but with the unit prices</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of the partial works concerned. As far as</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">separate items for setting up the site are not</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">contained in the bill of quantities for certain</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">work, the lump sum applies</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">to all work of this division of the bill of</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">quantities.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Access to the site exists.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Set up the site</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">This LV div.*access exist.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007960" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <StLNo Type="StLK">1010111202</StLNo>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Clear the site of all equipment, installations, facilities and</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the like. Restore used areas and paths in accordance with the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">original condition. As far as separate items for</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">clearing the site are not contained in the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">bill of quantities for certain</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">work, the lump sum applies</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">to all work of this division of the bill of</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">quantities.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Clear the site</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">This LV div.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2007962" RNoPart="02">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">Surveying works water pipeline </span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2007963">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">SURVEYING WATER PIPELINE</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2007964" RNoPart="0001">
                    <Qty>55.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Surveying services - </span>
                              <span style="font-weight:bold;background:#FFFFFF;">setting-out of the water pipeline</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Execution as position setting-out for structures, hydrant shafts and fixed points of the pipeline at changes of direction in the pipeline route.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The required digital drawing documents  are made available to the AN as DXF or DWG - file.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Payment is made exclusively for points set out electro-optically (total station setting-out and/or rover setting-out with GPS).</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Points set out by hand are to be included in the price in the overheads!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surveying services - setting-out of the water pipeline</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2007965" RNoPart="0002">
                    <Qty>55.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Work as item last described in full wording, but only surcharge to the item surveying works for additional setting-out of the </span>
                              <span style="font-weight:bold;background:#FFFFFF;">elevation</span>
                              <span style="background:#FFFFFF;"> at the respective point.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Work as item last described in full wording, but only surcharge to the item surveying works for additional setting-out of the elevation at the respective point.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2007966">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note for surveying services/as-built survey:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Surveying of route alignment </span>
                            </p>
                            <p/>
                            <p style="text-align:justify;margin-right:8pt;">
                              <span style="background:#FFFFFF;">The survey is made by position in the GK coordinate system with an accuracy of +/- 5 cm and by elevation in DHHN 12 with an accuracy of +/- 1 cm. The survey elevation refers to the top edge of the pipe. All survey points are to be recorded with different coding. All measurement records are to be handed over as well in analogue form. </span>
                            </p>
                            <p style="text-align:justify;margin-right:8pt;">
                              <span style="background:#FFFFFF;">Site management reserves the right to carry out check measurements. In case of deviation from the tolerance, site management decides on a new survey by the contractor.</span>
                            </p>
                            <p style="text-align:justify;margin-right:8pt;">
                              <span style="background:#FFFFFF;">The entire route is to be documented by means of digital photographs. All fittings and connecting pieces, valves, hydrants changes of dimension or material are to be documented hereby so that they can be assigned beyond doubt. the route is to be documented at least every 10 metres, each node with at least 3 photos from different perspectives. </span>
                            </p>
                            <p style="text-align:justify;margin-right:8pt;">
                              <span style="background:#FFFFFF;">The data are to be handed over to site management weekly.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Survey points of the route </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- all fittings and connecting pieces, hydrants and any valves,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- transitions of dimension or pipe material, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- the route is to be surveyed at least every 6 - 12 m,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- vertical offsets, high points, low points,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- end and start points of pipeline sections, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- crossing points (lines of other media)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- drainage of the hydrants (start, course, connection point)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Presentation of the measurement and laying drawings</span>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The route alignment is to be divided into the following layer structure:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">A_WL-GGG300		Water pipeline ductile iron DN300</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_WL-PE100DA355             Water pipeline PE100 DA355</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_WL-PE100DA63	Water pipeline PE100 DA63</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_WL-PE100DA40	Water pipeline PE100 DA40</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_[PERSON_017]		[PERSON_017]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_UEFH			Pillar hydrant</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_UFH			Underground hydrant</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_HA			Tapping valve house connection</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_Entw			Drainage line</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_Text			Text</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">A_Sonstiges		Other (text description in dwg for explanation)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">                                              </span>
                              <span style="font-weight:bold;background:#FFFFFF;">Other pipe dimensions, and materials are</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">                                              to be inquired!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- All surveyed points are to be shown with the respective symbol.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- All descriptions are to be placed on one text layer. It must be possible to assign them   unambiguously.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Length / dimension of the pipeline sections parallel to the line</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- Text designation such as couplings, crossings, depth of the pipes, </span>
                              <br/>
                              <span style="background:#FFFFFF;">  depth of the crossing line, must be written at the respective route</span>
                              <br/>
                              <span style="background:#FFFFFF;">  section.</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Handover of laying and measurement drawings 	</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The digital laying or measurement drawings are to be handed over in dwg, dxf and pdf format as well as in analogue form. The survey data are additionally to be handed over in ASCII format.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The following information must be contained in the ASCII- file:</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Point no.-, easting, northing; elevation, code, survey date, company; The code list, from which the definition of the individual points is apparent, must also be handed over. All drawings are to be submitted at scale 1:1000</span>
                              <span style="font-weight:bold;font-style:italic;background:#FFFFFF;"> </span>
                              <span style="background:#FFFFFF;">.</span>
                              <span style="font-weight:bold;font-style:italic;background:#FFFFFF;"> </span>
                              <span style="background:#FFFFFF;">Every working week a current survey drawing is to be presented to site management.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The ALK data for the area to be surveyed are made available to the AN.  </span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2007967" RNoPart="0003">
                    <Qty>150.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Surveying services - as-built water pipeline </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">with house connections</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Survey of all relevant points created in position and elevation, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">for checking and preparation of as-built drawings for the AG or </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">site management as described before.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Handover as digital CAD drawing (dwg format 2007) and in the form of list data (Ascii format). Gauss-Krüger is specified as coordinate system, DHHN12 as height system.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The list data must be unambiguously assignable to the drawing objects and, besides number, code if applicable, easting, northing and Z coordinate (elevation), contain all necessary information.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Where the line runs in the trench area, bends, changes of direction, fittings, [PERSON_017] and all required valves is to be surveyed digitally before the trench backfilling, the surveys are handed over to site management immediately after laying.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">All installed fittings are to be documented with symbol and short designation.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The surveys serve as basis for laying, billing and as-built layout drawing.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Included are all required technical facilities, materials, multiple journeys to site, as well as the additional data collections at the competent surveying office (fixed points TP, HP etc.) and at utility owners</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surveying services - as-built water pipeline </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
            <BoQCtgy ID="GW_2007968" RNoPart="03">
              <LblTx>
                <p>
                  <span style="background:#FFFFFF;">[ORT_030] [PROJEKT_001] in open-cut construction</span>
                </p>
              </LblTx>
              <NotApplBoQ>No</NotApplBoQ>
              <BoQBody>
                <Itemlist>
                  <Remark ID="GW_2007969">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">For the execution the following apply:                              </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for [ORT_030] in road construction (ZTVE-StB),  </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for the execution of base courses in </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">road construction (ZTVT-StB),                                 </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for the execution of soil stabilisation </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">and soil improvement in road construction (ZTVV-StB),      </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the technical delivery conditions for mineral aggregates    </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in road construction (TL Min-StB).                            </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The additional technical contract conditions and   </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">guidelines for excavations in traffic areas (ZTVA-StB).                     </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The leaflet for the backfilling of utility trenches.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Furthermore the following DIN standards with corresponding ATV`:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_030]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_019]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_008]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_031] outside buildings</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_021]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_010] (for topsoil works)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_018]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_003] with DWA - A 125</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">For the execution the following apply                              </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007970">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">The work is billed acc. to the respectively applicable</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN standards.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_030]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_019]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_008]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_031] outside buildings</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_021]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_010] (for topsoil works)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_018]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- DIN [ORT_003] with DWA - A 125</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">The work is billed acc. to the respectively applicable</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007971">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Demolition and reinstatement of pavement is paid under the items listed in the division roads.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Demolition and reinstatement of pavement is paid under the items listed in the division roads.</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007972">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">The determination of quantities for the billing of the work is made             </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">by measurement and the corresponding execution drawings</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in comparison with the newly prepared as-built drawing.</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The pipe surround is executed as follows:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Subsoil improvement only if needed</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Lower bedding layer d = 10 cm with [PERSON_182] 0/16 or 8/16</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Cover above pipe crown d = 30 cm with in-situ material max. </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">  100 mm grain size</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Trench width at excavation base acc. to EN 1610  1 x GGG pipe DN 300 ZMU</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">B = 1,20 m vertical with shoring</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Trench width acc. to EN 1610 sloped 45° to 60°,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">trench width at bottom (OK bedding layer = UK pipe)</span>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">for 1 x GGG DN 300 ZMU or 1 x PE DA 355,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">B = 0,75 m without shoring</span>
                              <span style="background:#FFFFFF;">, (B = excavation bottom of 0,55 m/45° - 0,65 m/60°).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Dimensions rounded.</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">The determination of quantities for the billing of the work is made             </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Remark ID="GW_2007973">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">The civil works are essentially tendered acc. to the new DIN 18300 (2015-08)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[ORT_030] on the basis of DIN 4020 geotechnical investigations for construction purposes with the corresponding homogeneous zones </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The basis is the geotechnical report by fm - Geotechnik</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">engineering office for geotechnics.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The homogeneous zones listed here are described in detail in the relevant </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">excavation items with their respective, estimated proportional quantities</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB A1: fills gravel</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   3, 4, </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB A2: fill [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 1: peat</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   2/4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 2:  weathered loam/slightly weathered ground moraine</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 3:  moraine sand</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   2,3,4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 4:  moraine gravel</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   3,4</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">HB B 5:  ground moraine, [PERSON_033]</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">           soil class DIN 18300 (2012-09)   4</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">As the cohesive soils encountered are partly sensitive to water, these soils can soften with improper temporary storage and with heavy precipitation during a transport or through mechanical stress, so that they may pass into soil class 2 acc. to DIN 18300 (2012-09) or into a pulpy consistency.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The AN</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">has to ensure</span>
                              <span style="background:#FFFFFF;"> </span>
                              <span style="font-weight:bold;background:#FFFFFF;">that these sensitive soils do not</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">pass into soil class 2.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">A payment for soil class 2 does not take place!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">The civil works are essentially acc. to the new DIN 18300 (2015-08)</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2007974" RNoPart="0001">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Difficulty surcharge</span>
                              <span style="background:#FFFFFF;"> to all road and civil works items in all trades for compliance with the required special measures in the course of the present soil protection concept as follows:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon Ah humus topsoil/ cultivable topsoil</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Proper handling strip and re-spread topsoil:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">If topsoil is temporarily stored in heaps, above-ground plant parts are to be removed as well as possible ahead of the</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">topsoil stripping,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in order to be able to minimise harmful decomposition during temporary storage in heaps</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The topsoil stockpiles are to be laid out as loose fill, with a max. height</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of 2,00 m.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The stockpile is to be profiled in trapezoidal shape and must be smoothed, in order to avoid weather-related waterlogging.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">During temporary storage the biological activity of the topsoil is to </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">be preserved.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Necessary therefore are sufficient aeration, protection against waterlogging and, for topsoil material stored for longer, planting with labiates.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon Bv cultivable [PERSON_057] below the Ah horizon,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">to approx. - 0,80 m below ground OK</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Excavate [PERSON_057], store at the side and reinstall:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Material can and should be used for initial backfilling and re-backfilling under a sufficiently thick Ah - layer.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The cultivable [PERSON_057] (weathered loam/[PERSON_033])) is to be removed and reinstalled with care, excessive compaction and resulting </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">change of structure and waterlogging must be avoided.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The subsoil stockpiles are to be laid out with smoothed flanks of max. 3 m height.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon C I</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">From a depth of - 0,80 m below ground OK aeolian-shaped </span>
                              <span style="font-weight:bold;background:#FFFFFF;">"cover layers"</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Slightly to weakly clayey, sandy, as well as weakly gravelly silts.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Horizon C II </span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Deeper subsoil cover loams and moraine sediments </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">moraine sand, moraine gravel and ground moraine.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">General requirements for the handling of all horizons:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The individual horizons should if possible be reinstalled in their original order, i.e. A over B over C.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Mixing of the material of the individual horizons is to be avoided.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Displaced, surplus excavation must be placed in heaps on a storage area </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">, sampled acc. to EBV/VwV Baden Württemberg and then taken to a suitable recycling facility.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Corresponding items are provided for this in the tender.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Minimising of driving over areas and maximum reduction of transport distances, use of tracked excavators with long-reach buckets; </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">no bulldozers, use of tractors with favourable tyre pressure on sensitive ground.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">No driving on the surrounding open areas = taboo areas ( e.g. agricultural areas ); unavoidable driving over only with vehicles of low ground pressure ( tracked vehicles, tractors with tipping trailer, wheeled vehicles only in combination with suitable underlays ).</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">In the area of the pipeline route in public paths with execution </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">vertical in shoring, the AN has to price for work sequences in the </span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">overhead method, both for the path construction and for the civil works water pipeline.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">A corresponding additional deployment of machines and personnel must be taken into account here without fail!</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The total length of the affected path and laying sections in the shored trench is approx. 90 - 100 m, of which approx. 80 m in the forest path area from</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">approx. station 0+990 - to 1+070 end of construction.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The execution of the work in general, is to be carried out after prior coordination with the respective property owners, or tenants of the affected properties also with regard to necessary meadow cuts and forestry work!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">This applies to cut and fill areas!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The estimator is urgently recommended to inspect the corresponding,</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">available soil protection concept!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">All additional expenditure compared with the tendered work items with regard to a conventional construction method, is to be included in the price here as</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">difficulty surcharge.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">There is no payment beyond this!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Difficulty surcharge to all road and civil works items in all trades for compliance with the required special measures in the course of the present soil protection concept as follows:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2010131" RNoPart="0002">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Surcharge</span>
                              <span style="background:#FFFFFF;"> - </span>
                              <span style="font-weight:bold;background:#FFFFFF;">item for all civil works</span>
                              <span style="background:#FFFFFF;"> in the connection area new line/</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">existing line GGG DN 300 at start of construction DZ NZ Isnyberg 400-401, station 0+000. </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The following work is to be included in the price:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- The entire connection work civil works, incl. the required </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  manpower (up to 2. crews), incl. all required machines</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  and materials (shaft, backfill material, auxiliary building materials etc.) must be executed within      a period of 6 - max. 8 h on the same working day and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  be completed.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- After completion of the works the water pipeline must imperatively be put back into </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  operation!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- The surcharge - item for the material supply and installation of the pipes and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  installation is paid separately in the trade supply and lay the pipeline </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  .</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">-  The coordination of civil works and assembly works has to take place internally between the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  civil works company and pipe-laying company.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note:</span>
                              <span style="background:#FFFFFF;"> A deviation from the time requirement tendered here is not </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               permitted , the connection at the end of construction of the water pipeline DZ NZ </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Isnyberg - 365 is to be executed separately in time and is also </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               paid separately! </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               The estimator has, with regard to labour effort and logistics, all </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               additional expenditure compared with the otherwise tendered </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               LV - items to include here in the surcharge - item.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">              </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> There is no payment beyond this!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The execution of the shaft drainage with pipes DA 110 can subsequently also take place on the next working day.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surcharge - item for all civil works in the connection area new line/</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2010163" RNoPart="0003">
                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Surcharge</span>
                              <span style="background:#FFFFFF;"> - </span>
                              <span style="font-weight:bold;background:#FFFFFF;">item for all civil works</span>
                              <span style="background:#FFFFFF;"> in the connection area new line/</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">existing line GGG DN 300 at end of construction DZ NZ Isnyberg - 365 ,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">station 1+066.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The following work is to be included in the price:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Text   The entire connection work civil works, incl. the required </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  manpower (up to 2. crews), incl. all required machines</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  and materials (shaft, backfill material, auxiliary building materials etc.) must be executed within      a period of 6 - max. 8 h on the same working day and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  be completed.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- After completion of the works the water pipeline must imperatively be put back into </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  operation!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- The surcharge - item for the material supply and installation of the pipes and </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  installation is paid separately in the trade supply and lay the pipeline </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  .</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">-  The coordination of civil works and assembly works has to take place internally between the </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  civil works company and pipe-laying company.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note:</span>
                              <span style="background:#FFFFFF;"> A deviation from the time requirement tendered here is not </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               permitted , the connection at the start of construction of the water pipeline DZ NZ </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               Isnyberg 400 - 401 is to be executed separately in time and is also </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               paid separately! </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               The estimator has, with regard to labour effort and logistics, all </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               additional expenditure compared with the otherwise tendered </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               LV - items to include here in the surcharge - item.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">              </span>
                              <span style="font-weight:bold;background:#FFFFFF;"> There is no payment beyond this!</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Surcharge - item for all civil works in the connection area new line/</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
