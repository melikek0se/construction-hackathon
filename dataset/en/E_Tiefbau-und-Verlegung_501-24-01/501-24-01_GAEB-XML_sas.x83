                  <Remark ID="GW_2008235">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Safety note for the cutting, removal and disposal</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">of pipelines DN 100 - 150 ( among other dimensions ) of asbestos cement:</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The following work items with cutting, removing and disposing of the asbestos-containing pipelines must be priced in compliance with all provisions of the Technical Rules for Hazardous Substances TRGS 519.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">It is required that all tendered work is carried out as work with low exposure.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Low exposure exists at an asbestos fibre concentration at the workplace below 15.000 fibres/m³. (TRGS 519 No. 2.8)</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">The following points are to be observed in particular:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">- A competent person of the AN must be available and be named before</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  execution.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- An approval certificate of the equipment used is to be submitted</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- The acceptance confirmation of the landfill for the asbestos cement waste</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- The notification of the works to the responsible authority</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">Safety note for the cutting, removal and disposal</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">of pipelines DN 100 - 150 ( among other dimensions ) of asbestos cement:</span>
                              </p>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">The following work items with cutting, removing and disposing of the asbestos-containing pipelines must be priced in compliance with all provisions of the Technical Rules for Hazardous Substances TRGS 519.</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">It is required that all tendered work is carried out as work with low exposure.</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">Low exposure exists at an asbestos fibre concentration at the workplace below 15.000 fibres/m³. (TRGS 519 No. 2.8)</span>
                              </p>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">The following points are to be observed in particular:</span>
                              </p>
                              <p/>
                              <p>
                                <span style="background:#FFFFFF;">- A competent person of the AN must be available and be named before</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">  execution.</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">- An approval certificate of the equipment used is to be submitted</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">- The acceptance confirmation of the landfill for the asbestos cement waste</span>
                              </p>
                              <p>
                                <span style="background:#FFFFFF;">- The notification of the works to the responsible authority</span>
                              </p>
                              <p/>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008236" RNoPart="0026">
                    <Qty>7.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Demolition and disposal of an </span>
                              <span style="font-weight:bold;background:#FFFFFF;">asbestos cement pipe DN 100,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">(old water line),</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">as surcharge to the items water line trench excavation,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">including all required safety measures during removal, loading, transporting and dispose of at an appropriate hazardous waste landfill.</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">See item safety note!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">All fees for landfilling are likewise to be included in the price.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution in several partial pieces!</span>
                            </p>
                          </Text>
                        </DetailTxt>
