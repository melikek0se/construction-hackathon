                  <Remark ID="GW_2008249">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note for the following pipe items for house connection lines</span>
                            </p>
                            <p/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">These works are essentially intended for the renewal of existing water lines of the local supply (house connections).</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The LV - quantities and tendered fittings do not claim to be complete.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The pipe layer has to take this into account when ordering material and for any necessary keeping available on site, especially of repair material!</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Additional payment beyond these items will not be made!</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">The pipe materials for the emergency supplies are to be included in the price of the corresponding</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">items emergency supply/bypass line!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Note for the following pipe items for house connection lines</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
