                    <Qty>1.000</Qty>
                    <QU>psch</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Excavator horizontal directional bore PE DA 355,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">to support the drilling works, pull-in, recovery of obstacles etc.,</span>
