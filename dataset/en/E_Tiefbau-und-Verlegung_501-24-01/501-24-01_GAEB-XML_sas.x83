                  <Item ID="GW_2008060" RNoPart="0055">
                    <Qty>1.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Supply and install cable pulling shaft as follows:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Junction box 65 x 60 cm clear dimensions [PERSON_129] I</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">of precast reinforced concrete elements ≥ C 35/45 DIN 1045</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Designed according to DIN Fachbericht 101 for actions from:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">- road traffic (max. 100 kN wheel load)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">DIN 4085 "Berechnung des Erddrucks".</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Manhole cover according to DIN EN 124 and DIN 1229</span>
                            </p>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">class D 400</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129] [FIRMA_105]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Consisting of:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 base slab with seepage hole, 6,5 cm (80 kg)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">4 round steel bars d = 8 mm, L = 500 mm</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 box frame, 31 cm (118 kg)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 intermediate frame, 15 cm (71 kg)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Manhole cover 65 x 60 cm clear dimensions, consisting of:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 cover frame in Wateen steel edging, 12 cm high,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">can be dowelled on 2 sides (25 kg)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">1 cover with concrete filling in Wateen steel edging</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">without ventilation,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">class D 400 (118 kg)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The [PERSON_016] between the components are to be formed with Möfix (shaft construction mortar approved by the building authority)</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">or with</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">cement mortar (MG III) according to DIN 1045 section 6.7.1.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">Manufacturer/[PERSON_129]:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">[PERSON_129] 1 junction box 65 x 60 cm</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">[FIRMA_105]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Tel. [TELEFON_045]</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Fax [TELEFON_083] – 33</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">or of equivalent kind.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">[PERSON_172]. cl.D size IV L/B 900/800mm H 820mm</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008061" RNoPart="0056">
                    <Qty>5.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Soil of the trenches for cables,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">after removal of the surface paving </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">homogeneous zones according to DIN 18300 as follows:</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">HB A fills gravel and HB B loess loam, colluvial loam</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">soil classes 3 to 5 (old DIN 18300)</span>
                              <br/>
                              <span style="background:#FFFFFF;">loosen true to profile, store at the side and after laying of empty conduit backfill again</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">and compact.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Level displaced material from sand surround in the terrain.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Excavation depth up to 0,70 m, width of the bottom up to 0,3 m, </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">according to the Additional Technical Contract Conditions and Guidelines for Excavations in Traffic Areas (ZTV A-StB).</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution areas trenches for cables outside </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">water pipeline trench.</span>
                            </p>
