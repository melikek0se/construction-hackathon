                  <Item ID="GW_2008023" RNoPart="0034">
                    <Qty>700.000</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Geotextile robustness class 3                                  </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Material: polypropylene, single-layer,                            </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">mechanically bonded nonwoven, detector-tested   </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">static puncture force (DIN EN ISO 12236) at least 1800 N make: </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Secutex 201-GRK 3 C  or of equivalent kind, for trenches of all kinds.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">For separating the soil replacement bodies from the surrounding ground including additional effort in the vertical trench area during trench backfilling and</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">covering of lightweight fill foam glass gravel MISAPOR </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Standard Plus 10/50.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Execution and billing after consultation with site management!</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Note</span>
                              <span style="background:#FFFFFF;">: The geotextile for the interim storage area is paid in the item </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">interim storage area.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Geotextile robustness class 3                                  </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008025">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note</span>
                              <span style="background:#FFFFFF;"> on the items [PERSON_121] and line crossings:</span>
                            </p>
                            <p/>
                            <p>
                              <span style="background:#FFFFFF;">All hand excavation work and locating work directly 50 cm all round the lines to be exposed is, in the respective items line crossings,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">to be included in the price.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">For this area no [PERSON_121] is paid!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">The item [PERSON_121] is provided in addition to the aforementioned items and is charged left, right, before or after the lines for determining</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">the exact position for the exposure!</span>
                            </p>
                            <p/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Note on the items [PERSON_121] and line crossings:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="GW_2008026" RNoPart="0035">
                    <Qty>10.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Soil for [PERSON_121] as surcharge to all excavation items, </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">including hand excavation, excavate, for exposing lines, from ground surface, store excavated material at the side, backfill and compact,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">excavation depth up to 1,75 m,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">bottom width in m as required,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">execution predominantly as trial trenches in the area of lines with unknown or inexact knowledge of the position.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The [PERSON_121] directly at the line crossings is to be included in the price in the corresponding items and is not paid here.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Soil for [PERSON_121] as surcharge to all excavation items, </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008027" RNoPart="0036">
                    <Qty>3.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Crossing under existing lines and cables</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">of all kinds, for shoring, pipe laying, [ORT_030] and trench backfilling </span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">as</span>
                              <span style="font-weight:bold;background:#FFFFFF;"> surcharge</span>
                              <span style="background:#FFFFFF;"> to the excavation items.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Here all hand, locating, securing and exposing work as well as cable trench, the re-embedding with sand, route warning tape cable cover blocks etc. as well as the obstruction by the shoring and the other work are to be included in the price.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">If several lines lie together up to a spacing of 1,0 m, this is treated as one crossing.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="background:#FFFFFF;">Billing: per crossing under 1 time for all work named above and further work.</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;"/>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="font-weight:bold;background:#FFFFFF;">Note:</span>
                            </p>
                            <p style="text-align:justify;margin-left:1pt;">
                              <span style="font-weight:bold;background:#FFFFFF;">Crossings under/crossings of field drains and gas lines are paid in separate items.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Crossing under existing lines and cables</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008028" RNoPart="0037">
                    <Qty>10.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Work as the item last described in full wording,</span>
                              <br/>
                              <span style="background:#FFFFFF;">but lines running lengthwise, lying parallel, expose, secure,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">store at the side (if necessary suspend in the slope area)</span>
                              <br/>
                              <span style="background:#FFFFFF;">construct new trench and reinstall cable previously stored at the side.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution and billing also in the excavation/slope area of shaft structures to be constructed.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Work as item last described in full wording,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008031" RNoPart="0038">
                    <Qty>675.000</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Warning and locating tape with imprint                     </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">"Achtung Wasserleitung" with flat metal strip of stainless [PERSON_115] supply and lay for main and secondary lines,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">in longitudinal route together 1 x,                             </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">make: Weiss, [FIRMA_039] or similar</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Warning and locating tape with imprint                     </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008032" RNoPart="0039">
                    <Qty>2.000</Qty>
                    <QU>m3</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Fixed points for water pipeline pipes up to GGG DN 300 ZMU,</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">construct of concrete acc. to DVGW GW 310.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">Execution in various subareas after consultation with the AG.</span>
                            </p>
                            <p/>
                            <p>
                              <span style="font-weight:bold;background:#FFFFFF;">Note</span>
                              <span style="background:#FFFFFF;">: This work is carried out only if required!</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               The tendered cast-iron lines to be laid</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               are all to be constructed with restrained joints.</span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">               The corresponding joints are tendered as well</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Fixed points for water pipeline pipes up to GGG DN 300 ZMU,</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="GW_2008033" RNoPart="0040">
                    <Qty>3.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Dynamic plate load test according to TP-BF [ORT_016] B 8.3                         </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">by means of dynamic plate load device or light falling weight for determining the soil compaction. For pipeline trenches in paved paths and roads, at least every 25 m in the pipe zone.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Execution after prior consultation with site management.                </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Proof of compaction is to be furnished and documented via correlation between the measured values and the soil-specific Proctor density.           </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The records drawn up are to be handed over to the AG or site management.     </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The minimum requirements according to A-139 are to be complied with.</span>
                            </p>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">Dynamic plate load test according to TP-BF [ORT_016] B 8.3                         </span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Remark ID="GW_2008034">
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">The installation of soil replacement materials to be supplied is planned as follows:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The pipe surround/ trench backfilling as well as the road and path construction are executed as follows: </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Subsoil improvement only if required with [PERSON_182] 0/X, crushed stone, gravel 16/32   or cobbles, after prior consultation with the site management of the AG !</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Lower bedding layer water main DN 300 ZMU d = 10 cm gravel 0/16.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Lateral and top cover ZMU pipe DN 300 with in-situ re-        usable soil material of HB A and B.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Remaining trench backfilling above cover up to UK frost protection layer 0/45 road,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">  or UK [PERSON_182] 0/X path sub-base, likewise with  in-situ re-              usable soil material HB A and B.</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- Exception remaining trench backfilling with [PERSON_182] 0/X to be supplied in areas    with in-situ soil material not suitable for reinstallation, or under </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  asphalt surfaces, but only after prior consultation with the site management </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">  of the AG !</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">- [PERSON_182] 0/45 only in the area of paved surfaces </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">  asphalt or paving, in unpaved areas such as field paths [PERSON_182] 0/X. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Trench width at excavation bottom acc. to EN 1610  GGG pipe DN 300 ZMU</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">B = 1,20 m vertical with shoring</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Trench width acc. to EN 1610 sloped 45° to 60°,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">trench width at bottom (OK bedding layer = UK pipe)</span>
                              <span style="background:#FFFFFF;"> </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">for 1 x GGG DN 300 ZMU or 1 x PE DA 355,</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">B = 0,75 m without shoring</span>
                              <span style="background:#FFFFFF;">, (B = excavation bottom of 0,55 m/45° - 0,65 m/60°).</span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">Dimensions rounded.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">Note for all materials to be supplied with installation in the area of </span>
                            </p>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">existing groundwater:</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">The entire additional expenditure for compliance with all regulations regarding safety and hygiene for the protection of the groundwater is to be included in the corresponding items material supply.</span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="background:#FFFFFF;">All materials, components and construction aids used in the new construction project must not adversely affect the [PERSON_029] either hygienically or chemically. </span>
                            </p>
                            <p style="text-align:justify;"/>
                            <p style="text-align:justify;">
                              <span style="font-weight:bold;background:#FFFFFF;">The installation of the materials to be supplied is to be included in the price in the base item water pipeline trench!</span>
                            </p>
                            <p style="text-align:justify;"/>
                          </Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt>
                              <p>
                                <span style="background:#FFFFFF;">The installation of soil replacement materials to be supplied is planned as follows:</span>
                              </p>
                            </TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Remark>
