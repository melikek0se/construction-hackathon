                    <Qty>1.000</Qty>
                    <QU>t</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text>
                            <p>
                              <span style="background:#FFFFFF;">Slope and bed paving in the area of piped ditch sections </span>
                            </p>
                            <p>
                              <span style="background:#FFFFFF;">with  reinforced concrete pipes DN 300 and inlets PVC - pipes up to DA 160 in ditches,</span>
