<?xml version='1.0' encoding='UTF-8'?>
<!-- GXML Toolbox V3.3 R20200224;  [URL_012]  --><GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.2"><GAEBInfo><Version>3.2</Version><VersDate>2013-10</VersDate><Date>2025-05-16</Date><Time>13:37:20</Time><ProgSystem>/ GXML Toolbox V3.3 R20200224</ProgSystem><ProgName>ORCA AVA 23.2.1 - Professional Edition 23.02.01</ProgName></GAEBInfo><PrjInfo><NamePrj>152516</NamePrj><LblPrj>[PROJEKT_004]</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>83</DP><AwardInfo><Cat>SelectCall</Cat><Cur>EUR</Cur><CurLbl>Euro</CurLbl><SubmLoc/></AwardInfo><AddText><OutlineAddText><span>Preliminary remarks</span></OutlineAddText><DetailAddText><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">The </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Municipality of Maierhöfen,</span><span style="font-size:10pt;font-family:Arial;"> [ADRESSE_016], represented by the 1. mayor [PERSON_031], intends to renew and enlarge the stream culvert in Neppen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">The current piping has a diameter of 600 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">The planned piping consists of reinforced concrete pipes DN 800/900 mm,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">with two tangential shafts.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">The total length is 121 m.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Construction sequence :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Set up the site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt break-up at road crossing.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Construct pipe trench for reinforced concrete pipes,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">In the course of [ORT_030], removal of the existing stream piping.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Dewatering, [PERSON_139] stream.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Demolition of existing structure,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Transition from 800 concrete pipes to new 800 reinforced concrete pipes with VPC coupling.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Lay reinforced concrete pipes DN 800/900 mm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt installation at road crossing.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Topsoiling works.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">Clear the site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Construction period :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">The start of construction is variable (at [PERSON_125] AN).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;">The completion date is set at :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">28.11.25</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:185pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Preservation of evidence :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Before the start of construction (i.e. before setting up the site), a preservation of evidence by photographs and a description of the condition is to be carried out on the condition of the adjacent paths and yard areas, trees and enclosures etc.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">The expenses for this are not paid seperately and are to be included in the unit prices.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Standards on which the design and construction are based </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Rule set and DIN standards of the </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">DVGW</span><span style="font-size:10pt;font-family:Arial;">, German Association for Gas and Water</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">German construction contract procedures, VOB A, B, C, edition 2019</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Acceptance :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">A precondition for acceptance is the declaration of consent of the respective property owners that they agree with the condition in which their properties have been left.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">These declarations are to be obtained and submitted by the AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"/></DetailAddText></AddText><BoQ ID="id1848"><BoQInfo><Name>01</Name><LblBoQ>[PROJEKT_004]</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Section</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Area</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn><NoUPComps>2</NoUPComps><LblUPComp1 Type="Materials">Materials</LblUPComp1><LblUPComp2 Type="Wages">Labour</LblUPComp2><LblTime>Hours</LblTime></BoQInfo><BoQBody><BoQCtgy ID="id1850" RNoPart="01"><LblTx><p><span>Site setup and clearing</span></p></LblTx><BoQBody><Itemlist><Remark ID="id1851"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Preliminary remark SiGeKo :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Activities under the Construction Site Ordinance (SiGeKo) :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">The client (AG) assumes that the contractor (AN) carries out all construction work in its own business.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Thus no (further) activities under the Construction Site Ordinance are required.</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">If the contractor passes construction work on to subcontractors, activities under the Construction Site Ordinance become required.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The commissioning of a, then required, SiGe coordinator is done by the AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The costs for this are not paid seperately and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">are to be included in the unit prices.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:496pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Preliminary remark SiGeKo</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id1852" RNoPart="0001"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Setting up and clearing the site for all</span><br/><span style="font-size:10pt;font-family:Arial;">work listed in the description of work.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Transport to and from site of the required construction machinery,</span><br/><span style="font-size:10pt;font-family:Arial;">equipment, tools, site offices and storage rooms.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Construct power and water connection, as well as disposal facilities</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and the like for the site, as far as required.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Procure and lay out storage and working areas.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">After completion of the construction measure, restore areas </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">to the original condition.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Site setup and clearing</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Remark ID="id1853"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Traffic regulations</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Traffic regulations</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id1854" RNoPart="0002"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Traffic signs and signage</span><br/><span style="font-size:10pt;font-family:Arial;">according to the requirements of the traffic-law</span><br/><span style="font-size:10pt;font-family:Arial;">order: supply, set up, keep available on site</span><br/><span style="font-size:10pt;font-family:Arial;">and dismantle,</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">apply for traffic-law permit,</span><br/><span style="font-size:10pt;font-family:Arial;">secure the site continuously</span><br/><span style="font-size:10pt;font-family:Arial;">in accordance with the regulations.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Illuminate sources of danger at night, according to safety</span><br/><span style="font-size:10pt;font-family:Arial;">requirements.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Billing once for the duration of the</span><br/><span style="font-size:10pt;font-family:Arial;">entire construction period.</span><br/></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Traffic regulation and safety measures</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id1855" RNoPart="0003"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Traffic safety measures</span><br/><br/><span style="font-size:10pt;font-family:Arial;">(1) Access roads and paths soiled</span><br/><span style="font-size:10pt;font-family:Arial;">by site traffic: as needed, possibly several times</span><br/><span style="font-size:10pt;font-family:Arial;">a day, properly wet-clean</span><br/><span style="font-size:10pt;font-family:Arial;">with sweeper (Unimog).</span><br/><br/><span style="font-size:10pt;font-family:Arial;">(2) Secure open pipe trenches or other sources of danger</span><br/><span style="font-size:10pt;font-family:Arial;">by means of mobile site fence made of steel mesh elements.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Erect, keep available on site, relocate and dismantle site fence.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Traffic safety measures</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2055" RNoPart="0004"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Prepare billing documents, verifiable,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">billing site plan,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">using the execution documents on the basis of the state coordinates (UTM 32),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">determine UTM coordinates.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The UTM coordinates are, if possible, to be determined at the open trench</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">or by means of the foreman's reference marks and markings.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Submission of the drawings as a file</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in DWG or DXF format and 2 copies as colour plot.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Execution documents are made available to the AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in digital form free of charge.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Prepare billing documents</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id2152" RNoPart="02"><LblTx><p><span>Civil works</span></p></LblTx><BoQBody><Itemlist><Item ID="id2165" RNoPart="0001"><Qty>70.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Cut asphalt, with joint cutter,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">vertical cut, separate remaining thickness</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">at [PERSON_125] of the AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Asphalt thickness up to 15 cm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Cut asphalt, up to 15 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2166" RNoPart="0002"><Qty>12.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt break-up,</span><br/><span style="font-size:10pt;font-family:Arial;">break-up method </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">by means of excavator</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">or other suitable equipment,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">take broken asphalt into the ownership of the </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">AN and remove from the</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Asphalt thickness up to 15 cm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt break-up up to 15 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2211" RNoPart="0003"><Qty>260.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Topsoil,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">homogeneous zone B 0, DIN 18300,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">strip, with suitable equipment,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">stripping thickness up to 25 cm,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">stripping width in coordination with site management.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Store topsoil at the side properly in heaps,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">re-spread and level</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Topsoil stripping- and re-spreading</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2212" RNoPart="0004"><Qty>1300.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Used meadow areas</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">(topsoiled areas and storage areas)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">properly loosen, rake off and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">clear of stones,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">sow with meadow seed mixture in coordination</span><br/><span style="font-size:10pt;font-family:Arial;">with property owner,</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">sowing width in coordination with site management.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Greening works</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2213" RNoPart="0005"><Qty>270.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Pipe trench excavation for sewers and shafts,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">homogeneous zone B1 and B2,</span><br/><span style="font-size:10pt;font-family:Arial;">(formerly soil class 3-5, DIN 18300)</span><br/><span style="font-size:10pt;font-family:Arial;">excavate, store at the side, backfill again</span><br/><span style="font-size:10pt;font-family:Arial;">and compact,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">billing from UK topsoil or asphalt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Additional excavation for shafts, beyond the standard width,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">is not paid separately and is to be included in the price.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Compact pipe trench bottom properly,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">excavation with shoring or sloped, at [PERSON_125] of the AN,</span><br/><span style="font-size:10pt;font-family:Arial;">billing in every case vertical, according to standard width,</span><br/><span style="font-size:10pt;font-family:Arial;">additional excavation for slopes is to be included in the price.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Standard width :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">RB DN 800/900 mm = 2,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Excavation depth up to 2,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Excavated material </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">store at the side</span><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">provided it is geotechnically suitable,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">backfill again and compact.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Pipe trench excavation, up to 2m, store at the side, reinstall</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2214" RNoPart="0006"><Qty>130.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">as before, but</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">02) Haul excavated material</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and on AG storage area in stockpiles,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">store temporarily for sampling.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Transport distance up to 2 km.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Pipe trench excavation, removal to AG interim storage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2215" RNoPart="0007"><Qty>100.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">as before, but</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">03) [PERSON_093], uncontaminated, Z 0,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">haul directly to AN tip</span><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">including tipping fee.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Pipe trench excavation, Z0, haul to AN tip</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2216" RNoPart="0008"><Qty>130.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Pick up excavated material from AG interim storage,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">load onto truck</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Removal of excavated material, </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">uncontaminated, Z 0</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">to AN tip, incl. tipping fee.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Remark :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The stockpiles are sampled by others on site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and analysed for contamination with pollutants.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The disposal costs for contaminated soils</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">are borne by the AG.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Pick up excavated material from storage, removal Z 0 to AN tip</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2220" RNoPart="0009"><Qty>230.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Pipe support (bedding),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">bedding angle 120°,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">layer thickness : 15 cm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and side fill and cover,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">layer thickness : 20 cm above pipe crown</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">produce, according to DIN EN 1610,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">installation within the standard width,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">displacement by shafts and</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">pipes is deducted.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Use of</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">fine gravel (levelling gravel) 0/32 mm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Sewers DN 800/900 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Pipe support and embedment, fine gravel 0/32 mm, up to DN 900 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2234" RNoPart="0010"><Qty>3.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Pipe support for inlet structure,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">produce with concrete (concrete support),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">thickness 20 cm,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">supply concrete C 12/15 and install</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">to correct level and compact.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Concrete support for inlet structure, thickness 20 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2217" RNoPart="0011"><Qty>35.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Soil replacement within pipe trench:</span><br/><span style="font-size:10pt;font-family:Arial;">produce, supply replacement material,</span><br/><span style="font-size:10pt;font-family:Arial;">install to correct level and compact,</span><br/></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">billing vertical,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">according to standard width (RB) :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">RB DN 800/900 mm = 2,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">Additional widths due to slopes are</span><br/><span style="font-size:10pt;font-family:Arial;">to be included in the price.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">01) Rounded gravel 16/32 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Soil replacement pipe trench - rounded gravel 16/32 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2218" RNoPart="0012"><Qty>50.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">as before, but</span><br/><span style="font-size:10pt;font-family:Arial;">02) Pit gravel (cohesive pit-run gravel),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">grading 0/X, not frost-resistant</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Soil replacement pipe trench - pit gravel</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2194" RNoPart="0013"><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Surcharge on [ORT_030] for </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">[PERSON_121]</span><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">depth up to 1,25 m,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">lines, cables and sewers to be crossed</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">in </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">machine-assisted hand excavation</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">according to the regulation of the respective utility provider</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">carefully expose.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Expose down to </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">top edge</span><span style="font-size:10pt;font-family:Arial;"> of the respective utility.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The complete exposure of the utility by</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">manual work (hand excavation) is paid in the item "Passing under".</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Surcharge for [PERSON_121]</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2195" RNoPart="0014"><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Passing under exposed lines,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">cables and sewers (exposed down to OK),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">lines, cables and sewers (obstacles)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">completely by </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">machine-assisted manual work</span><span style="font-size:10pt;font-family:Arial;"> expose,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">secure obstacles properly, according to the</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">regulations of the respective utility provider</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">restoration of the supports and [PERSON_072]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">supply [PERSON_072].</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Passing under transversely, within pipe trench width</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Passing under lines, cables and sewers, transverse</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2196" RNoPart="0015"><Qty>20.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">as before, but</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">02) Passing under longitudinally, within excavation pit</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Billing per lfdm.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Passing under lines, cables and sewers, longitudinal</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2177" RNoPart="0016"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Dewatering stream,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">carry out at [PERSON_125] AN,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">dewatering by [PERSON_139]</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> or diversion</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">by means of diversion channel,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">length of diversion channel up to 10 m.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Construct, keep available on site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and dismantle diversion channel,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">all material remains the property</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">of the AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Pumping or diversion rate</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">up to 150 l/s.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Dewatering stream up to 150 l/s</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2180" RNoPart="0017"><Qty>100.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Components which are exposed in the course of excavation work:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">remove,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">take material into the ownership of the AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and remove from the site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Concrete pipes DN 600 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Remove existing stream piping DN 600 concrete, dispose of</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2192" RNoPart="0018"><Qty>4.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Existing structure (intermediate shaft)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">demolish,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">floor, walls and ceiling</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">of reinforced concrete,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">demolition with suitable equipment</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">at [PERSON_125] of the AN, by machine and by hand.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Load [PERSON_047] (concrete and reinforcing steel),</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">move within the site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and store in stockpiles (batches) in coordination with site management.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Demolish structure, store rubble temporarily</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2193" RNoPart="0019"><Qty>10.000</Qty><QU>to</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[PERSON_047] (concrete and reinforcing steel)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">stored in stockpiles, after declaration</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">pick up, </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">take into the ownership of the AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and pass on to proper disposal,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">according to RC-Leitfaden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Declaration is carried out by others on site.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Material uncontaminated, according to RC-Leitfaden</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Remark :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The stockpiles are sampled by others on site</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">and analysed for contamination with pollutants.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">The disposal costs for contaminated material</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">are borne by the AG.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Pick up and dispose of [PERSON_047] - classification :  RW 1</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2182" RNoPart="0020"><Qty>25.000</Qty><QU>to</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Armourstones</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">supply and place properly,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">to secure the embankment of the Happacher Bach,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">fill voids between the</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">stacked armourstones</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">with fine gravel/sand,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">supply fine gravel/sand.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Armourstones C 200/400</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Supply and place armourstones C 200/400</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2201" RNoPart="0021"><Qty>50.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Produce frost protection layer (FSS),</span><br/><span style="font-size:10pt;font-family:Arial;">supply frost protection gravel, grading 0/56 mm,</span><br/><span style="font-size:10pt;font-family:Arial;">install true to level and profile according to standard profile</span><br/><span style="font-size:10pt;font-family:Arial;">and compact,</span><br/><span style="font-size:10pt;font-family:Arial;">produce a fine grade with levelling gravel 16/32 mm</span><br/><span style="font-size:10pt;font-family:Arial;">to be supplied.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Deformation modulus Ev2 min. 120 MN/m2</span><br/><span style="font-size:10pt;font-family:Arial;">Ratio of the deformation moduli Ev2/Ev1 max 2,2</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Total thickness of the unbound base course up to 52 cm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Billing according to actual installed thickness.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Incl. proof of the required deformation</span><br/><span style="font-size:10pt;font-family:Arial;">moduli by means of </span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">dynamic</span><span style="font-size:10pt;font-family:Arial;"> plate load tests.</span><br/><br/><span style="font-size:10pt;font-family:Arial;">Number of plate load tests in coordination with</span><br/><span style="font-size:10pt;font-family:Arial;">site management.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Produce frost protection layer, thickness up to 52 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2203" RNoPart="0022"><Qty>70.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt base course of [PERSON_173]</span><br/><span style="font-size:10pt;font-family:Arial;"> 70/100,</span><br/><span style="font-size:10pt;font-family:Arial;">in varying widths on frost protection layers</span><br/><span style="font-size:10pt;font-family:Arial;">by machine (paver) and by hand,install,</span><br/><span style="font-size:10pt;font-family:Arial;">unevenness of the surface max. 6 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Installation between edgings.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) AC 32 TN, installed thickness 10 cm (250 kg/m2)</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Bituminous gravel AC 32 TN - thickness 10 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2205" RNoPart="0023"><Qty>3.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Existing asphalt surface</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">mill off, with milling machine,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">over the entire carriageway width,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">milling thickness at least 4 cm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">01) Milled material remains the property of the AG.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">Billing by m3</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Load milled material onto truck,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">haul to AG tip and unload,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">transport distance one way up to 3 km.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Mill asphalt, 4 cm - milled material to AG storage area</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2207" RNoPart="0024"><Qty>90.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt</span><span style="font-size:10pt;text-decoration:underline ;font-family:Arial;">surface</span><span style="font-size:10pt;font-family:Arial;">course AC 11 DN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">of [PERSON_173]</span><br/><span style="font-size:10pt;font-family:Arial;"> 50/70,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">according to ZTV Asphalt-StB,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">unevenness of the surface max. 6 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">supply, install to correct level and compact.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Installed thickness 4 cm (100 kg/m2)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Installation with paver and by hand</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Asphalt concrete 0/11 mm, thickness 4 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2208" RNoPart="0025"><Qty>30.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Produce connection to existing surfaces in the</span><br/><span style="font-size:10pt;font-family:Arial;">thickness of the asphalt surface course with fusible</span><br/><span style="font-size:10pt;font-family:Arial;">joint tape (TOK-Band),</span><br/><span style="font-size:10pt;font-family:Arial;">longitudinal and transverse joint, width at least 10 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">01) Thickness of the surface course 40 mm</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">TOK-Band 40 mm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id2202" RNoPart="0026"><Qty>3.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Produce gravel shoulders,</span><br/><span style="font-size:10pt;font-family:Arial;">supply, install and compact</span><br/><span style="font-size:10pt;font-family:Arial;">shoulder gravel 0/22 mm,</span><br/><span style="font-size:10pt;font-family:Arial;">installed width up to 50 cm, thickness 5-8 cm,</span><br/><span style="font-size:10pt;font-family:Arial;">installation with crossfall 6%,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><br/><span style="font-size:10pt;font-family:Arial;">according to standard profile.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:10pt;font-family:Arial;">Produce gravel shoulders</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="id2153" RNoPart="03"><LblTx><p><span>Reinforced concrete pipes, shafts, inlet structure</span></p></LblTx><BoQBody><Itemlist><Item ID="id2221" RNoPart="0001"><Qty>10.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">UHPC reinforced concrete pipes,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">according to EN 1916 and DIN V 1201 [PERSON_129] 2,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">with FBS approval and structural proof,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">supply and lay properly.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Manufactured length :  3,00 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">With compression sliding ring seal</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">of elastomers with dense structure</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">firmly built into the socket,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Concrete grade C 80/95</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Concrete strength up ot 120 N/mm2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Concrete flexural tensile strength &gt; 16 N/mm2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Load class above LC 250,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">modulus of elasticity (38 kN/mm2), ductile behaviour</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Exposure classes : </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">XC4, XD3, XF4, XA2, XM2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;"> </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Manufacturer :</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">[FIRMA_084] &amp; Co. KG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">Betonwarenfabriken</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font