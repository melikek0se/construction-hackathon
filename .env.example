ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Only needed for real outbound phone calls (not for the in-browser demo)
ELEVENLABS_PHONE_NUMBER_ID=

# Database: Postgres in production (e.g. Neon); unset = SQLite file data/boq.db
DATABASE_URL=
# Password for the whole app (HTTP basic auth, any user name); unset = open
BOQ_PASSWORD=
# Mail account the app may send from (bidder questions). Unset = messages open as drafts in your mail program.
# In `docker compose up` an unset SMTP_HOST means Mailpit: mail is caught at http://localhost:8025 and goes no further.
# Port 587 (STARTTLS) or 465 (TLS). SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The inbox the app looks into for the client's replies (IMAP over TLS, port 993). Unset: replies are pasted in.
# User and password default to SMTP_USER and SMTP_PASSWORD. Gmail: smtp.gmail.com / imap.gmail.com with an
# app password (Google account > Security > 2-Step Verification > App passwords), not the account password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
