ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Only needed for real outbound phone calls (not for the in-browser demo)
ELEVENLABS_PHONE_NUMBER_ID=

# Database: Postgres in production (e.g. Neon); unset = SQLite file data/boq.db
DATABASE_URL=
# Password for the whole app (HTTP basic auth, any user name); unset = open
BOQ_PASSWORD=
# Mail account the app may send from (bidder questions, price inquiries). Unset = messages open as drafts in
# your mail program. Port 587 (STARTTLS, the default) or 465 (TLS). SMTP_FROM defaults to SMTP_USER.
# In `docker compose up` an unset SMTP_HOST / IMAP_HOST means the demo mail server (webmail at
# http://localhost:8025/webmail/, password "demo"): the app is kalkulation@polier.test there and nothing
# leaves the laptop.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The inbox the app looks into (replies, tenders, history with partners): IMAP over TLS, port 993 by default.
# Unset: replies are pasted in. User and password default to SMTP_USER and SMTP_PASSWORD. Gmail: smtp.gmail.com /
# imap.gmail.com with an app password (Google account > Security > 2-Step Verification > App passwords).
# With a real account in docker compose also set IMAP_TLS=1 and DEMO_MAIL_URL=off (both are for the demo server).
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=
# Production image only: 1 = run the demo mail server and its webmail (/webmail/) inside the container and
# use it as the app's mailbox. Its mail is kept in Postgres, in a database of its own next to DATABASE_URL's.
DEMO_MAIL=
