ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Only needed for real outbound phone calls (not for the in-browser demo)
ELEVENLABS_PHONE_NUMBER_ID=

# Database: Postgres in production (e.g. Neon); unset = SQLite file data/boq.db
DATABASE_URL=
# Password for the whole app (HTTP basic auth, any user name); unset = open
BOQ_PASSWORD=
# Mail account the app may send from (bidder questions). Unset = messages open as drafts in your mail program.
# Port 587 (STARTTLS) or 465 (TLS). SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
